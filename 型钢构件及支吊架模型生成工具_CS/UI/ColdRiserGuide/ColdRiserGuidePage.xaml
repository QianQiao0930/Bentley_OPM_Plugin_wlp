<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.ColdRiserGuidePage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/SupportTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <proto:PrototypeChrome Title="保冷立管导向架" Code="L7/L8" Caption="HOME / 支吊架 / 参数设置 · 点取与预览" Icon="M18 9 L12 3 L6 9 M12 3 V17 M5 21 H19" Accent="#0E9F9A" IconBackground="#E6F6F5" IconBorder="#C7EAE8"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                            <Run Text="01 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                            <Run Text="保冷立管导向架类型" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                        </TextBlock>
                    </Border>
                    <StackPanel Margin="12">
                        <TextBlock Text="先选择 L7 / L8，再选择类型，随后点取放置（DN15～DN150）。" TextWrapping="Wrap" Margin="0,0,0,5" FontWeight="SemiBold"/>
                        <ComboBox x:Name="SeriesCombo" SelectionChanged="Series_Changed" Margin="0,0,0,8" Style="{StaticResource ModelCombo}"/>
                        <ComboBox x:Name="KindCombo" SelectionChanged="Kind_Changed" Style="{StaticResource ModelCombo}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="02 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="规格与构件" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock Text="点取真实管道时读取管径、外径及保冷厚度；点取竖直辅助线时使用下方数值。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="公称直径（辅助线时使用）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                <ComboBox x:Name="DnCombo" SelectionChanged="Data_Changed" Style="{StaticResource ModelCombo}"/>
                                <TextBlock Text="保冷厚度（mm；无属性时使用）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                <TextBox x:Name="ColdText" Text="50" TextChanged="Data_Changed" Style="{StaticResource ModelInput}"/>
                                <TextBlock Text="承重夹板沿管轴长度（mm，默认 300）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                <TextBox x:Name="BearingLengthText" Text="300" TextChanged="Data_Changed" Style="{StaticResource ModelInput}"/>
                                <StackPanel x:Name="MaterialPanel" Margin="0,8,0,0">
                                    <TextBlock Text="材料代码（L8 编号）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="MaterialCombo" SelectionChanged="Data_Changed" Style="{StaticResource ModelCombo}"/>
                                </StackPanel>
                                <TextBlock x:Name="DataText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock x:Name="Type1Info" Text="类型 1：构件 A 按 A22 计算内径 A 选型。L 从管中心至构件末端；默认 300 mm，拉伸范围 300～1000 mm。" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock x:Name="MeasureText" Text="L = 300 mm；待点取方向" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,10,0,0">
                <StackPanel>
                    <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                            <Run Text="03 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                            <Run Text="点取与确认" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                        </TextBlock>
                    </Border>
                    <StackPanel Margin="12">
                        <TextBlock x:Name="ProcessText" Text="类型 1：点取标高 → XY 罗盘定方向 → 拉伸构件 A → 预览 → 确定。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <Button Content="开始点取" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="32"/>
                            <Button Content="结束操作" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" Margin="0" Grid.Column="2" Grid.Row="0" Height="32"/>
                            <Button x:Name="UpdateButton" Content="更新预览" Style="{StaticResource SecondaryButtonStyle}" Click="Update_Click" Margin="0" Grid.Column="4" Grid.Row="0" Height="32"/>
                        </Grid>
                        <TextBlock x:Name="PreviewText" Text="尚未点取立管。" TextWrapping="Wrap" Margin="0,6,0,12.0" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" MaxHeight="42" TextTrimming="CharacterEllipsis" FontSize="11"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <Button Content="取消预览" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="36"/>
                            <Button x:Name="ConfirmButton" Content="确定生成" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsEnabled="False" Grid.Column="2" Grid.Row="0" Margin="0" Height="36"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
