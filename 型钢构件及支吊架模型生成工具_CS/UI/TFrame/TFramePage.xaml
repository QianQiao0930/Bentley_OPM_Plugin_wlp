<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.TFramePage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/SupportTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <proto:PrototypeChrome Title="T 型架" Code="D12/G4/D15" Caption="HOME / 支吊架 / 参数设置 · 点取与预览" Icon="M13.73 4 A2 2 0 0 0 10.27 4 L2.27 18 A2 2 0 0 0 4 21 H20 A2 2 0 0 0 21.73 18 Z" Accent="#0E9F9A" IconBackground="#E6F6F5" IconBorder="#C7EAE8"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="01 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="T 型架类别与子项" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock x:Name="KindHint" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="类别" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="KindCombo" SelectionChanged="Kind_Changed" Style="{StaticResource ModelCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="子项" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="VariantCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="类型" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="TypeCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="DimensionLabel" Text="横担全长 L（mm）"/>
                                        <TextBox x:Name="DimensionText" Text="250" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="HeadingPanel" Margin="0,8,0,0">
                                    <TextBlock Text="平面方向角（度，0° 为世界 +X）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                    <TextBox x:Name="HeadingText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                </StackPanel>
                                <StackPanel x:Name="D15Panel" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="接点焊接形式（只进编号）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="JointCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="筋板 h×w（只进编号，可留空）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="StiffenerText" TextChanged="Stiffener_Changed" Style="{StaticResource ModelInput}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <CheckBox x:Name="KeepLineCheck" Content="确认后保留辅助线" IsChecked="True" Margin="0,8,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Style="{StaticResource ModelCheck}"/>
                                <TextBlock x:Name="SectionText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock x:Name="LimitText" TextWrapping="Wrap" Foreground="{DynamicResource StatusBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="0">
                <StackPanel>
                    <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                            <Run Text="02 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                            <Run Text="点取与预览" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                        </TextBlock>
                    </Border>
                    <StackPanel Margin="12">
                        <TextBlock Text="调整参数后更新预览；确定时才写入支吊架清单。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <Button Content="开始点取" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="32"/>
                            <Button Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" Margin="0" Grid.Column="2" Grid.Row="0" Height="32"/>
                            <Button x:Name="UpdateButton" Content="更新预览" Style="{StaticResource SecondaryButtonStyle}" Click="Update_Click" Margin="0" Grid.Column="4" Grid.Row="0" Height="32"/>
                        </Grid>
                        <TextBlock x:Name="PreviewText" Text="尚未选择辅助线。" TextWrapping="Wrap" Margin="0,6,0,12.0" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" MaxHeight="42" TextTrimming="CharacterEllipsis" FontSize="11"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <Button Content="取消预览" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="36"/>
                            <Button x:Name="ConfirmButton" Content="确定生成" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsEnabled="False" Grid.Column="2" Grid.Row="0" Margin="0" Height="36"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
