<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.BracketPage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/SupportTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <proto:SupportPageTitleConverter x:Key="SupportTitle"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <proto:PrototypeChrome Title="{Binding Text,ElementName=TitleText,Converter={StaticResource SupportTitle}}" Code="{Binding Text,ElementName=TitleText,Converter={StaticResource SupportTitle},ConverterParameter=Code}" Caption="HOME / 支吊架 / 参数设置 · 点取与预览" Icon="M13.73 4 A2 2 0 0 0 10.27 4 L2.27 18 A2 2 0 0 0 4 21 H20 A2 2 0 0 0 21.73 18 Z" Accent="#0E9F9A" IconBackground="#E6F6F5" IconBorder="#C7EAE8"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock x:Name="InstructionText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="类型" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="TypeCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="子项" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="SubtypeCombo" SelectionChanged="Subtype_Changed" Style="{StaticResource ModelCombo}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="HeightLabelText" Text="H：两块连接板中心距（mm）" TextWrapping="Wrap" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                    <TextBox x:Name="HeightText" TextChanged="Height_TextChanged" Style="{StaticResource ModelInput}"/>
                                    <CheckBox x:Name="ReverseCheck" Content="反向（交换辅助线两端）" Margin="0,10,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Style="{StaticResource ModelCheck}"/>
                                    <CheckBox x:Name="KeepLineCheck" Content="创建后保留所选辅助线" IsChecked="True" Margin="0,6,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Style="{StaticResource ModelCheck}"/>
                                    <TextBlock x:Name="SectionText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <StackPanel x:Name="SinglePreweldPanel" Margin="0,10,0,0">
                                        <CheckBox x:Name="N3ShowPreweldCheck" Content="生成设备预焊件占位" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Style="{StaticResource ModelCheck}"/>
                                        <TextBlock Text="预焊件总长 D（mm，含占位端板）" TextWrapping="Wrap" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="N3PreweldText" Text="100" IsEnabled="{Binding IsChecked,ElementName=N3ShowPreweldCheck}" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        <TextBlock Text="勾选后，从辅助线起点生成两处透明占位；支架 L 扣除 D，横担实长再扣连接板厚度。占位不计材料。" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="EPanel" Background="{StaticResource CardSoftBrush}" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
                                        <TextBlock x:Name="EText" Text="E：点取辅助线后计算（最小 150 mm）。" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DoublePanel" Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                <TextBlock Text="N4 设备与跨距尺寸" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="L2：两横担间距（mm）" TextWrapping="Wrap" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="L2Text" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        <TextBlock Text="L3：管中心到外侧构件 C（mm）" TextWrapping="Wrap" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="L3Text" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        <TextBlock Text="L4：管中心到内侧构件 C（mm）" TextWrapping="Wrap" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="L4Text" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="设备外径 2R（mm，必填）" TextWrapping="Wrap" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="EquipmentOdText" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        <TextBlock Text="预焊件长度 D（mm，可为 0）" TextWrapping="Wrap" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="PreweldText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        <CheckBox x:Name="ShowPreweldCheck" Content="显示设备预焊件参照" Margin="0,8,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Style="{StaticResource ModelCheck}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="0">
                <StackPanel>
                    <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                            <Run Text="03 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                            <Run Text="点取与预览" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                        </TextBlock>
                    </Border>
                    <StackPanel Margin="12">
                        <TextBlock x:Name="PreviewInstructionText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <Button Content="开始点取" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="32"/>
                            <Button Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" Margin="0" Grid.Column="2" Grid.Row="0" Height="32"/>
                            <Button x:Name="UpdateButton" Content="更新预览" Style="{StaticResource SecondaryButtonStyle}" Click="Update_Click" Margin="0" Grid.Column="4" Grid.Row="0" Height="32"/>
                        </Grid>
                        <TextBlock x:Name="PreviewText" Text="尚未选择水平辅助线。" TextWrapping="Wrap" Margin="0,6,0,12.0" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" MaxHeight="42" TextTrimming="CharacterEllipsis" FontSize="11"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <Button Content="取消预览" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="36"/>
                            <Button x:Name="ConfirmButton" Content="确定生成" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsEnabled="False" Grid.Column="2" Grid.Row="0" Margin="0" Height="36"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
