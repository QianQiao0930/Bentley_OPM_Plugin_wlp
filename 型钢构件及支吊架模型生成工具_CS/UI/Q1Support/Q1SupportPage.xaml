<UserControl x:Class="SteelSectionProbe.Q1SupportPage" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource BackgroundBrush}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Themes/Theme.xaml" />
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="80"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
   <StackPanel>
    <Border Style="{StaticResource CardStyle}"><StackPanel>
     <TextBlock Text="01  大管支撑小管" Style="{StaticResource SectionTitleStyle}"/>
     <ComboBox x:Name="SeriesCombo" SelectedIndex="0" SelectionChanged="Series_Changed"><ComboBoxItem Content="Q1 竖向角钢支撑"/><ComboBoxItem Content="Q2 横向角钢支撑"/></ComboBox>
     <TextBlock Text="大管用角钢支撑小管（不保温管）" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <TextBlock Text="布置类型"/>
     <ComboBox x:Name="TypeCombo" SelectedIndex="0" SelectionChanged="Parameter_Changed">
      <ComboBoxItem Content="类型 1 · 小管在下，两管垂直"/>
      <ComboBoxItem Content="类型 2 · 小管在上，两管垂直"/>
      <ComboBoxItem Content="类型 3 · 小管在上，两管平行（带垫板）"/>
      <ComboBoxItem Content="类型 4 · 小管在下，两管平行（带垫板）"/>
     </ComboBox>
     <StackPanel x:Name="Q2Panel" Visibility="Collapsed">
      <TextBlock Text="Q2 子项（按允许荷载选取）" Margin="0,12,0,0"/>
      <ComboBox x:Name="Q2ItemCombo" SelectedIndex="0" SelectionChanged="Parameter_Changed"><ComboBoxItem Content="A · ∠50×6"/><ComboBoxItem Content="B · ∠75×7"/><ComboBoxItem Content="C · ∠100×10"/></ComboBox>
      <TextBlock Text="立管安装方式（类型3/4）" Margin="0,12,0,0"/>
      <ComboBox x:Name="BearingCombo" SelectedIndex="0" SelectionChanged="Parameter_Changed"><ComboBoxItem Content="A 承重/固定 · 两螺母同在外侧"/><ComboBoxItem Content="G 承重/导向 · 两螺母一内一外，留3mm"/></ComboBox>
     </StackPanel>
     <TextBlock Text="被支撑小管公称直径" Margin="0,12,0,0"/>
     <ComboBox x:Name="SmallDnCombo" SelectionChanged="Parameter_Changed"/>
     <TextBlock x:Name="DistanceLabel" Text="小管与大管中心间距 H（mm，最大 1000）" TextWrapping="Wrap" Margin="0,12,0,0"/>
     <TextBox x:Name="HeightText" Text="500" TextChanged="Parameter_Changed"/>
     <CheckBox x:Name="MirrorCheck" Content="镜像（角钢放在大管另一侧）" Margin="0,12,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed"/>
     <TextBlock x:Name="SpecificationText" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" Margin="0,12,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource CardStyle}"><StackPanel>
     <TextBlock Text="02  点取与预览" Style="{StaticResource SectionTitleStyle}"/>
     <TextBlock Text="点取后可沿轴调整位置；Q2类型4先绕立管调整角度，左键锁定后生成预览。" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <WrapPanel>
      <Button Content="开始点取" Click="Pick_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8"/>
      <Button Content="结束点取" Click="End_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
      <Button x:Name="UpdateButton" Content="更新预览" Click="Update_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
      <Button x:Name="AngleButton" Content="调整角度" Visibility="Collapsed" Click="Angle_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8"/>
      <Button Content="沿轴滑动" Click="Slide_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8"/>
     </WrapPanel>
     <WrapPanel VerticalAlignment="Center">
      <TextBlock Text="沿轴偏移（mm）" VerticalAlignment="Center" Margin="0,0,8,8"/>
      <TextBox x:Name="AxisOffsetText" Text="0" Width="120" TextChanged="AxisOffset_Changed" Margin="0,0,8,8"/>
      <Button Content="应用偏移" Click="ApplyOffset_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8"/>
     </WrapPanel>
     <TextBlock x:Name="AxisPositionText" Text="基点：尚未点取。" TextWrapping="Wrap"/>
     <TextBlock x:Name="PreviewText" Text="尚未选取支撑大管。" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" Style="{StaticResource CardStyle}"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button Grid.Column="2" x:Name="ConfirmButton" Content="确定生成" IsEnabled="False" Click="Confirm_Click" Style="{StaticResource PrimaryButtonStyle}"/>
    <Button Content="取消预览" Click="End_Click" Style="{StaticResource SecondaryButtonStyle}"/>
   </Grid>
  </StackPanel></Border>
 </Grid>
</UserControl>
