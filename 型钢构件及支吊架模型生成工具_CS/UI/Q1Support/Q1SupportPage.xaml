<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.Q1SupportPage" x:ClassModifier="internal" Tag="q-support-v4" Background="#F4F7FA">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="QSupportTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:QSupportResultConverter x:Key="Result"/>
            <local:QSupportLayoutConverter x:Key="LayoutResult"/>
            <local:QSupportRangeConverter x:Key="Range"/>
            <DrawingBrush x:Key="GridPaper" TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="White" Geometry="M0,0 H14 V14 H0 Z"/>
                        <GeometryDrawing Geometry="M0,0 H14 M0,0 V14">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#EEF2F7" Thickness="1"/>
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="63"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleDrag_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                    <Path Data="{StaticResource QBrandIcon}" Fill="Black"/>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="型钢构件及支吊架模型生成工具" FontSize="12" Foreground="#5B6B7B" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="─" Click="MinimizeUi_Click" Style="{StaticResource HomeButton}" Height="32" BorderThickness="0"/>
                <Button Grid.Column="3" Content="×" Click="CloseUi_Click" Style="{StaticResource HomeButton}" Height="32" BorderThickness="0" FontSize="18"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" x:Name="ModuleHeader" Background="{StaticResource GridPaper}" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1">
            <Grid Margin="16,12,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Border Background="#E6F6F5" BorderBrush="#C7EAE8" BorderThickness="1" CornerRadius="6">
                    <Path Data="M 6,17 A 4,4 0 1 0 14,17 A 4,4 0 1 0 6,17 M 14,13 L 19,8 M 18,7 A 3,3 0 1 0 24,7 A 3,3 0 1 0 18,7" Stroke="#0E9F9A" StrokeThickness="1.6" Width="25" Height="25" Stretch="Uniform" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="大管支撑小管" FontSize="15" FontWeight="Bold"/>
                        <Border Background="#EEF3F8" CornerRadius="3" Margin="6,1,0,1" Padding="4,0">
                            <TextBlock FontFamily="Consolas" FontSize="10" Foreground="#5B6B7B">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Q1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex,ElementName=SeriesCombo}" Value="1">
                                                <Setter Property="Text" Value="Q2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="HOME / 支吊架 / 角钢 · 不保温小管" FontFamily="Consolas" FontSize="10" Foreground="#94A3B3" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="3" Content="‹ 返回首页" Click="BackHome_Click" Style="{StaticResource HomeButton}" Height="30" Padding="4,0"/>
                <Path xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Grid.Column="0" Data="M0,8 V0 H8 M30,38 H38 V30" Stroke="#1F6FEB" StrokeThickness="2" Margin="-3" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <ScrollViewer x:Name="ParameterScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource QCard}" Margin="16,12,10,12">
                <StackPanel>
                    <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="01 /" Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Text="参数设置" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock Text="PARAMETERS" Style="{StaticResource QHint}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="12">
                        <Grid>
                            <TextBlock Text="管架系列" Style="{StaticResource QLabel}"/>
                            <TextBlock Text="SERIES · Q1 / Q2" Style="{StaticResource QHint}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ComboBox x:Name="SeriesCombo" SelectedIndex="0" SelectionChanged="Series_Changed" Margin="0,0,0,11">
                            <ComboBoxItem Content="Q1 竖向角钢支撑"/>
                            <ComboBoxItem Content="Q2 横向角钢支撑"/>
                        </ComboBox>
                        <Grid>
                            <TextBlock Text="布置类型" Style="{StaticResource QLabel}"/>
                            <TextBlock Text="LAYOUT · 4 种" Style="{StaticResource QHint}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ComboBox x:Name="TypeCombo" SelectedIndex="0" SelectionChanged="Parameter_Changed" Margin="0,0,0,11">
                            <ComboBoxItem Content="类型1 · 小管在下，两管垂直"/>
                            <ComboBoxItem Content="类型2 · 小管在上，两管垂直"/>
                            <ComboBoxItem Content="类型3 · 小管在上，两管平行（带垫板）"/>
                            <ComboBoxItem Content="类型4 · 小管在下，两管平行（带垫板）"/>
                        </ComboBox>
                        <StackPanel x:Name="Q2Panel" Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="Q2 子项" Style="{StaticResource QLabel}"/>
                                <TextBlock Text="按允许荷载选取" Style="{StaticResource QHint}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ComboBox x:Name="Q2ItemCombo" SelectedIndex="0" SelectionChanged="Parameter_Changed" Margin="0,0,0,11">
                                <ComboBoxItem Content="A · ∠50×6"/>
                                <ComboBoxItem Content="B · ∠75×7"/>
                                <ComboBoxItem Content="C · ∠100×10"/>
                            </ComboBox>
                            <Grid>
                                <TextBlock Text="立管安装方式" Style="{StaticResource QLabel}"/>
                                <TextBlock Text="类型 3 / 4" Style="{StaticResource QHint}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ComboBox x:Name="BearingCombo" SelectedIndex="0" SelectionChanged="Parameter_Changed" Margin="0,0,0,11">
                                <ComboBoxItem Content="A 承重/固定 · 两螺母同在外侧"/>
                                <ComboBoxItem Content="G 承重/导向 · 两螺母一内一外，留3mm"/>
                            </ComboBox>
                        </StackPanel>
                        <Grid>
                            <TextBlock Text="被支撑小管公称直径" Style="{StaticResource QLabel}"/>
                            <TextBlock Text="DN · INCH" Style="{StaticResource QHint}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ComboBox x:Name="SmallDnCombo" SelectionChanged="Parameter_Changed" Margin="0,0,0,11"/>
                        <TextBlock x:Name="DistanceLabel" Text="小管与大管中心间距 H（mm，最大1000）" Style="{StaticResource QLabel}" FontSize="11.5" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource QNumberFrame}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="−" Tag="HeightText:-50" Click="StepUi_Click" Style="{StaticResource QStepper}"/>
                                <TextBox x:Name="HeightText" Grid.Column="1" Text="500" TextChanged="Parameter_Changed"/>
                                <Border Grid.Column="2" Background="#FAFBFC" BorderBrush="#E8EDF2" BorderThickness="1,0">
                                    <TextBlock Text="mm" Style="{StaticResource QHint}" HorizontalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="3" Content="+" Tag="HeightText:50" Click="StepUi_Click" Style="{StaticResource QStepper}"/>
                            </Grid>
                        </Border>
                        <ProgressBar Height="3" Margin="0,6,0,11" Maximum="1000" Value="{Binding Text,ElementName=HeightText,Converter={StaticResource Range},Mode=OneWay}" Style="{StaticResource QRange}" Foreground="#1F6FEB"/>
                        <CheckBox x:Name="MirrorCheck" Style="{StaticResource QMirror}" Checked="Parameter_Changed" Unchecked="Parameter_Changed"/>
                        <Grid>
                            <TextBlock Text="选型结果" Style="{StaticResource QLabel}"/>
                            <TextBlock Text="RESULT · 自动匹配" Style="{StaticResource QHint}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border x:Name="SelectionResult" Style="{StaticResource QCard}" Height="98" ToolTip="{Binding Text,ElementName=SpecificationText}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#FAFBFC" BorderBrush="#E8EDF2" BorderThickness="0,0,1,0">
                                    <local:QSupportSchematic Series="{Binding SelectedIndex,ElementName=SeriesCombo}" Layout="{Binding SelectedIndex,ElementName=TypeCombo}" Mirrored="{Binding IsChecked,ElementName=MirrorCheck}"/>
                                </Border>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="10,0">
                                        <Grid>
                                            <TextBlock Text="子项" Foreground="#5B6B7B" FontSize="11.5" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Text,ElementName=SpecificationText,Converter={StaticResource Result},ConverterParameter=Subitem}" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#0E9F9A"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="10,0">
                                        <Grid>
                                            <TextBlock Text="角钢" Foreground="#5B6B7B" FontSize="11.5" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Text,ElementName=SpecificationText,Converter={StaticResource Result},ConverterParameter=Angle}" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="2" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="10,0">
                                        <Grid>
                                            <TextBlock Text="允许荷载" Foreground="#5B6B7B" FontSize="11.5" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Text,ElementName=SpecificationText,Converter={StaticResource Result},ConverterParameter=Load}" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="3" BorderBrush="#E8EDF2" BorderThickness="0,0,0,0" Padding="10,0">
                                        <Grid>
                                            <TextBlock Text="布置" Foreground="#5B6B7B" FontSize="11.5" VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource LayoutResult}">
                                                        <Binding ElementName="TypeCombo" Path="SelectedIndex"/>
                                                        <Binding ElementName="MirrorCheck" Path="IsChecked"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SpecificationText" Visibility="Collapsed"/>
                        <TextBlock Text="{Binding Text,ElementName=SpecificationText}" Foreground="#D9434A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Text,ElementName=SpecificationText,Converter={StaticResource Result},ConverterParameter=ErrorVisibility}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Border x:Name="PreviewDock" Grid.Row="3" Background="#F4F7FA" BorderBrush="#DDE3EA" BorderThickness="0,1,0,0" Padding="16,10,16,12">
            <StackPanel>
                <Border Style="{StaticResource QCard}">
                    <StackPanel>
                        <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="02 /" Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <TextBlock Text="点取与预览" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="PICK &amp; PREVIEW" Style="{StaticResource QHint}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="12">
                            <UniformGrid Columns="4" Height="24" Margin="0,0,0,10">
                                <UniformGrid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Foreground" Value="#94A3B3"/>
                                        <Setter Property="Background" Value="#F4F7FA"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="0,4"/>
                                        <Setter Property="Margin" Value="0,0,4,0"/>
                                    </Style>
                                </UniformGrid.Resources>
                                <TextBlock Text="① 参数设置"/>
                                <TextBlock Text="② 选取大管" ToolTip="点击大管，同时确定基点并生成预览"/>
                                <TextBlock Text="③ 调整预览"/>
                                <TextBlock Text="④ 确定生成" Margin="0"/>
                            </UniformGrid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="Pick_Click" Style="{StaticResource QPrimary}" FontSize="11.5">
                                    <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Orientation="Horizontal">
                                        <Path Data="M6,0 V4 M6,9 V13 M0,6 H4 M9,6 H13 M6,3 L9,6 L6,9 L3,6 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="开始点取" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Click="End_Click" Style="{StaticResource QButton}" FontSize="11.5">
                                    <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Orientation="Horizontal">
                                        <Path Data="M2,2 H11 V11 H2 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="结束点取" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Click="Update_Click" Style="{StaticResource QButton}" FontSize="11.5" x:Name="UpdateButton">
                                    <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Orientation="Horizontal">
                                        <Path Data="M11,5 A5,5 0 1 0 11,9 M11,1 V5 H7" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="更新预览" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="6" Click="Slide_Click" Style="{StaticResource QButton}" FontSize="11.5">
                                    <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Orientation="Horizontal">
                                        <Path Data="M0,6 H13 M0,6 L3,3 M0,6 L3,9 M13,6 L10,3 M13,6 L10,9" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="沿轴滑动" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button x:Name="AngleButton" Visibility="Collapsed" Click="Angle_Click" Style="{StaticResource QButton}" Margin="0,0,0,8">
                                <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Orientation="Horizontal">
                                    <Path Data="M11,5 A5,5 0 1 0 11,9 M11,1 V5 H7" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="调整角度 · 绕主管立管" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="沿轴偏移" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Grid Grid.Column="2">
                                    <Border Style="{StaticResource QNumberFrame}" Height="32">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="−" Tag="AxisOffsetText:-10" Click="StepUi_Click" Style="{StaticResource QStepper}" Height="30"/>
                                            <TextBox x:Name="AxisOffsetText" Grid.Column="1" Text="0" TextChanged="AxisOffset_Changed"/>
                                            <Border Grid.Column="2" Background="#FAFBFC" BorderBrush="#E8EDF2" BorderThickness="1,0">
                                                <TextBlock Text="mm" Style="{StaticResource QHint}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Button Grid.Column="3" Content="+" Tag="AxisOffsetText:10" Click="StepUi_Click" Style="{StaticResource QStepper}" Height="30"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Button Grid.Column="4" Content="应用偏移" Click="ApplyOffset_Click" Style="{StaticResource QButton}"/>
                            </Grid>
                            <Border Height="56" Background="#FAFBFC" BorderBrush="#E8EDF2" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="#E8EDF2" BorderThickness="0,0,0,0">
                                        <Grid Margin="10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6" Height="6" Fill="#C3CDD8" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="预览" FontFamily="Consolas" FontSize="11" Foreground="#94A3B3" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PreviewText" Grid.Column="2" Text="尚未选取支撑大管。" FontFamily="Consolas" FontSize="11" Foreground="#5B6B7B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" BorderBrush="#E8EDF2" BorderThickness="0,1,0,0">
                                        <Grid Margin="10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6" Height="6" Fill="#C3CDD8" HorizontalAlignment="Left"/>
                                            <TextBlock Grid.Column="1" Text="基点" FontFamily="Consolas" FontSize="11" Foreground="#94A3B3" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AxisPositionText" Grid.Column="2" Text="基点：尚未点取。" FontFamily="Consolas" FontSize="11" Foreground="#5B6B7B" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <Button Click="End_Click" Height="36" Style="{StaticResource QButton}" FontSize="13" Content="取消预览"/>
                    <Button x:Name="ConfirmButton" Grid.Column="2" IsEnabled="False" Click="Confirm_Click" Height="36" Style="{StaticResource QPrimary}" FontSize="13">
                        <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Orientation="Horizontal">
                            <Path Data="M1,7 L5,11 L12,2" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="确定生成" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
