<?xml version="1.0" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ModelingTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="CardSoftBrush" Color="#E6F6F5"/>
    <Style TargetType="CheckBox" x:Key="SupportElementCheck">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="#1B2733"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Mark" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" Background="White" BorderBrush="#B9C6D4" BorderThickness="1" CornerRadius="3">
                            <Path x:Name="Tick" Data="M2,6 L5,9 L10,3" Stroke="White" StrokeThickness="1.6" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Background" Value="#1F6FEB"/>
                            <Setter TargetName="Mark" Property="BorderBrush" Value="#1F6FEB"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Mark" Property="BorderBrush" Value="#1F6FEB"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton" x:Key="SupportElementRadio">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Mark" Width="14" Height="14" CornerRadius="7" BorderBrush="#B9C6D4" Background="White" BorderThickness="1" VerticalAlignment="Top" Margin="0,2,0,0">
                            <Ellipse x:Name="Dot" Fill="#1F6FEB" Margin="3" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Mark" Property="BorderBrush" Value="#1F6FEB"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Mark" Property="BorderBrush" Value="#1F6FEB"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
