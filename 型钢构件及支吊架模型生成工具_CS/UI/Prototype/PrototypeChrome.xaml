<UserControl x:Class="SteelSectionProbe.PrototypeChrome" x:ClassModifier="internal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SteelSectionProbe" Height="95">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PrototypeTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        <DrawingBrush x:Key="GridPaper" TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="White" Geometry="M0,0 H14 V14 H0 Z"/><GeometryDrawing Geometry="M0,0 H14 M0,0 V14"><GeometryDrawing.Pen><Pen Brush="#EEF2F7" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
    </ResourceDictionary></UserControl.Resources>
    <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="63"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" MouseLeftButtonDown="Title_MouseLeftButtonDown"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="36"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
            <Viewbox Width="16" Height="16" VerticalAlignment="Center"><Path Data="{StaticResource QBrandIcon}" Fill="Black"/></Viewbox><TextBlock Grid.Column="1" Text="型钢构件及支吊架模型生成工具" FontSize="12" Foreground="#5B6B7B" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="─" Click="Minimize_Click" Height="32" BorderThickness="0" Style="{StaticResource HomeButton}" ToolTip="最小化"/><Button Grid.Column="3" Content="×" Click="Close_Click" Height="32" BorderThickness="0" FontSize="18" Style="{StaticResource HomeButton}" ToolTip="关闭"/>
        </Grid></Border>
        <Border Grid.Row="1" Background="{StaticResource GridPaper}" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1"><Grid Margin="16,12,12,12"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
            <Border Background="{Binding IconBackground,RelativeSource={RelativeSource AncestorType=local:PrototypeChrome}}" BorderBrush="{Binding IconBorder,RelativeSource={RelativeSource AncestorType=local:PrototypeChrome}}" BorderThickness="1" CornerRadius="6"><Path Data="{Binding Icon,RelativeSource={RelativeSource AncestorType=local:PrototypeChrome}}" Stroke="{Binding Accent,RelativeSource={RelativeSource AncestorType=local:PrototypeChrome}}" StrokeThickness="1.6" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center"/></Border>
            <Path Data="M0,8 V0 H8 M30,38 H38 V30" Stroke="#1F6FEB" StrokeThickness="2" Margin="-3" IsHitTestVisible="False"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title,RelativeSource={RelativeSource AncestorType=local:PrototypeChrome}}" FontSize="15" FontWeight="Bold"/><Border Background="#EEF3F8" CornerRadius="3" Margin="6,1,0,1" Padding="4,0"><TextBlock Text="{Binding Code,RelativeSource={RelativeSource AncestorType=local:PrototypeChrome}}" FontFamily="Consolas" FontSize="10" Foreground="#5B6B7B" VerticalAlignment="Center"/></Border></StackPanel><TextBlock Text="{Binding Caption,RelativeSource={RelativeSource AncestorType=local:PrototypeChrome}}" FontFamily="Consolas" FontSize="10" Foreground="#94A3B3" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
            <Button Grid.Column="3" Content="‹ 返回首页" Click="Home_Click" Style="{StaticResource HomeButton}" Height="30" Padding="4,0"/>
        </Grid></Border>
    </Grid>
</UserControl>
