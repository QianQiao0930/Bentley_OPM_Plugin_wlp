<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.ActivationPage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/PrototypeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:PrototypeChrome Title="软件激活" Code="KEY" Caption="HOME / 授权 / 永久 · 试用 · 离线激活" Icon="M5,12 V7 A6,6 0 0 1 17,7 V12 M3,12 H19 V23 H3 Z M11,16 V20"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="1" Margin="16,12,10,12">
            <StackPanel Margin="0">
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                            <TextBlock Text="授权状态" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12">
                            <TextBlock x:Name="ActivationStatusText" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LicenseInfoText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                <Run Text="01 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                <Run Text="复制本机机器码" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                            </TextBlock>
                        </Border>
                        <StackPanel Margin="12">
                            <TextBlock Text="申请永久授权时需提供机器码；申请一个月或 90 天试用码无需机器码。" TextWrapping="Wrap"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MachineCodeText" IsReadOnly="True" FontSize="10" VerticalContentAlignment="Center" Margin="0,0,8,0" Padding="6,6"/>
                                <Button x:Name="CopyMachineButton" Grid.Column="1" Content="复制" Style="{StaticResource SecondaryButtonStyle}" Click="CopyMachine_Click" Width="54"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                <Run Text="02 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                <Run Text="输入激活码或试用码" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                            </TextBlock>
                        </Border>
                        <StackPanel Margin="12">
                            <TextBlock Text="粘贴完整授权码即可使用全部功能。试用从签发时刻起计时，以授权到期时间为准。" TextWrapping="Wrap"/>
                            <TextBox x:Name="ActivationCodeText" Height="130" Margin="0,10,0,12" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="8192"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ActivateButton" Content="激活 / 启用试用" Margin="0" Style="{StaticResource PrimaryButtonStyle}" Click="Activate_Click" Grid.Column="0"/>
                                <Button Content="联系作者" Margin="0" Style="{StaticResource SecondaryButtonStyle}" Click="ContactAuthor_Click" Grid.Column="2"/>
                            </Grid>
                            <TextBlock x:Name="ResultText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource StatusBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
