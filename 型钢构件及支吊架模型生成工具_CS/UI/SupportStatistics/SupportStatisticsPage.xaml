<UserControl x:Class="SteelSectionProbe.SupportStatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
             Background="{DynamicResource BackgroundBrush}"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ReportHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="Background" Value="#F4F7FB" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="7,5" />
            </Style>
            <Style x:Key="ReportThumbStyle" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="#7189A4" CornerRadius="3" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ReportTrackButtonStyle" TargetType="RepeatButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ControlTemplate x:Key="ReportHorizontalScrollTemplate" TargetType="ScrollBar">
                <Border Background="#EAF0F6" CornerRadius="3">
                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                          Style="{StaticResource ReportTrackButtonStyle}" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ReportThumbStyle}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                          Style="{StaticResource ReportTrackButtonStyle}" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate>
            <ControlTemplate x:Key="ReportVerticalScrollTemplate" TargetType="ScrollBar">
                <Border Background="#EAF0F6" CornerRadius="3">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand"
                                          Style="{StaticResource ReportTrackButtonStyle}" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ReportThumbStyle}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand"
                                          Style="{StaticResource ReportTrackButtonStyle}" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate>
            <Style x:Key="ReportScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Width" Value="6" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Template" Value="{StaticResource ReportVerticalScrollTemplate}" />
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Height" Value="6" />
                        <Setter Property="Template" Value="{StaticResource ReportHorizontalScrollTemplate}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReportGridStyle" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource ReportHeaderStyle}" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="RowBackground" Value="White" />
                <Setter Property="AlternatingRowBackground" Value="#FAFBFC" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Visible" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="ReportScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      SizeChanged="ReportScrollViewer_SizeChanged"
                      ScrollChanged="ReportScrollViewer_ScrollChanged"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="01  当前文件统计" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="读取当前 DGN 文件的 PipeSupportComponents 属性；进入页面自动刷新。"
                                   Foreground="Black" TextWrapping="Wrap" Margin="0,0,0,9" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="支吊架总套数" Foreground="Black" />
                                <TextBlock x:Name="TotalText" Text="—" FontSize="20"
                                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="记录与材料" Foreground="Black" />
                                <TextBlock x:Name="CountText" Text="—" FontSize="12"
                                           Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="FileText" Foreground="{StaticResource StatusBrush}"
                                   Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="02  按类型汇总" Style="{StaticResource SectionTitleStyle}" />
                        <DataGrid x:Name="TypeGrid" Style="{StaticResource ReportGridStyle}"
                                  Height="150">
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ReportScrollBarStyle}" />
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="支吊架类型" Binding="{Binding SupportType}" Width="170" />
                                <DataGridTextColumn Header="套数" Binding="{Binding AssemblyCount}" Width="75" />
                                <DataGridTextColumn Header="编号列表" Binding="{Binding AssemblyTags}" Width="520" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="03  支吊架表" Style="{StaticResource SectionTitleStyle}" />
                        <DataGrid x:Name="SupportGrid" Style="{StaticResource ReportGridStyle}"
                                  Height="220">
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ReportScrollBarStyle}" />
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="类型" Binding="{Binding SupportType}" Width="110" />
                                <DataGridTextColumn Header="编号" Binding="{Binding AssemblyTag}" Width="200" />
                                <DataGridTextColumn Header="管道号" Binding="{Binding PipeNumber}" Width="130" />
                                <DataGridTextColumn Header="规格" Binding="{Binding Specification}" Width="150" />
                                <DataGridTextColumn Header="构件明细" Binding="{Binding Details}" Width="230" />
                                <DataGridTextColumn Header="元素 ID" Binding="{Binding ElementId}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="04  材料汇总表" Style="{StaticResource SectionTitleStyle}" />
                        <DataGrid x:Name="MaterialGrid" Style="{StaticResource ReportGridStyle}"
                                  Height="220">
                            <DataGrid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ReportScrollBarStyle}" />
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="支吊架类型" Binding="{Binding SupportType}" Width="120" />
                                <DataGridTextColumn Header="构件名称" Binding="{Binding ComponentName}" Width="125" />
                                <DataGridTextColumn Header="规格" Binding="{Binding Specification}" Width="240" />
                                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="65" />
                                <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="70" />
                                <DataGridTextColumn Header="总长 (mm)" Binding="{Binding TotalDesignLengthMm}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,6,4,0">
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="刷新统计" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Refresh_Click" Margin="0,0,7,0" />
                <Button x:Name="ExcelButton" Content="导出 Excel 清单"
                        Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"
                        Click="Excel_Click" Margin="0,0,7,0" />
                <Button x:Name="JsonButton" Content="导出 JSON"
                        Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                        Click="Json_Click" />
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
