<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.PortalFramePage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/SupportTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <proto:PrototypeChrome Title="门型架" Code="D8…D20" Caption="HOME / 支吊架 / 参数设置 · 点取与预览" Icon="M13.73 4 A2 2 0 0 0 10.27 4 L2.27 18 A2 2 0 0 0 4 21 H20 A2 2 0 0 0 21.73 18 Z" Accent="#0E9F9A" IconBackground="#E6F6F5" IconBorder="#C7EAE8"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="01 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="门型架种类与子项" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock x:Name="LineInstruction" Text="选择种类与子项后，点取整组中心竖直辅助线；线长为门架高度 H。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="种类" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="KindCombo" SelectionChanged="Kind_Changed" Style="{StaticResource ModelCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="子项" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="VariantCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="形式" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="TypeCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="SpanLabel" Text="净距 B（mm）"/>
                                        <TextBox x:Name="SpanText" Text="500" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="HeadingLabel" Text="平面方向角（度）"/>
                                        <TextBox x:Name="HeadingText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="管架编号名称" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="NameText" Text="D8" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="HorizontalPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <TextBlock Text="接点焊接型式（仅选择，不改变几何）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="WeldCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="L3（mm，类型 2）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="L3Text" Text="200" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="L4（mm，0 表示无内侧 B）" TextWrapping="Wrap" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="L4Text" Text="200" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="辅助线长为 L1。类型 1：L1 到 B 的竖肢/腹板外边缘，A 总长 L1+50。类型 2：两根 B 背靠背，A 总长 L1+L3+B 宽度+50；L4=0 不生成内侧 B。A/B 截面中心保持同一标高。" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="PlatePanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <CheckBox x:Name="PlateCheck" Content="起始端附加 G2 混凝土锚板及锚栓（两套）" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Style="{StaticResource ModelCheck}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="G2 锚板子项" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="PlateSubtypeCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="端板外移量（mm）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="PlateOffsetText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <CheckBox x:Name="KeepLineCheck" Content="确认后保留辅助线" IsChecked="True" Margin="0,8,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Style="{StaticResource ModelCheck}"/>
                                <TextBlock x:Name="SectionText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="0">
                <StackPanel>
                    <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                            <Run Text="02 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                            <Run Text="点取与预览" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                        </TextBlock>
                    </Border>
                    <StackPanel Margin="12">
                        <TextBlock x:Name="PickInstruction" Text="选择竖直辅助线，调整参数后更新预览；确定时才写入支吊架清单。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <Button Content="开始点取" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="32"/>
                            <Button Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" Margin="0" Grid.Column="2" Grid.Row="0" Height="32"/>
                            <Button x:Name="UpdateButton" Content="更新预览" Style="{StaticResource SecondaryButtonStyle}" Click="Update_Click" Margin="0" Grid.Column="4" Grid.Row="0" Height="32"/>
                        </Grid>
                        <TextBlock x:Name="PreviewText" Text="尚未选择竖直辅助线。" TextWrapping="Wrap" Margin="0,6,0,12.0" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" MaxHeight="42" TextTrimming="CharacterEllipsis" FontSize="11"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <Button Content="取消预览" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="36"/>
                            <Button x:Name="ConfirmButton" Content="确定生成" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsEnabled="False" Grid.Column="2" Grid.Row="0" Margin="0" Height="36"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
