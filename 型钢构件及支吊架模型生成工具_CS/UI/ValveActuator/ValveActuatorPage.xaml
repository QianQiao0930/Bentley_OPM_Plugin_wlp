<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SteelSectionProbe"
             x:Class="SteelSectionProbe.ValveActuatorPage" x:ClassModifier="internal" Tag="prototype-v4" Background="#F4F7FA">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Prototype/ModelingTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="95"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <local:PrototypeChrome x:Name="PageChrome" Title="阀门执行机构" Code="ACT" Caption="HOME / 建模 / 阀门附件"
            Accent="#1F6FEB" IconBackground="#EAF2FF" IconBorder="#CADFFB" Icon="M2,7 L12,2 22,7 12,12 Z M2,12 L12,17 22,12 M2,17 L12,22 22,17"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="ParameterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="10,8">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/><ColumnDefinition Width="6"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="LibraryCountText" Text="01 / 选择单元库" FontSize="12" FontWeight="SemiBold" Foreground="#1F6FEB" VerticalAlignment="Center"/>
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="选择 CEL" Style="{StaticResource SecondaryButtonStyle}" Click="Browse_Click" Height="28" Margin="0"/>
                                <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click" Height="28" Margin="0" IsEnabled="False"/>
                            </Grid>
                            <TextBlock x:Name="LibraryPathText" Text="尚未选择 CEL 文件" FontSize="10.5" Foreground="#5B6B7B" Margin="0,6,0,8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                            <TextBlock Text="库内三维单元" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CellCombo" DisplayMemberPath="DisplayName" Style="{StaticResource ModelCombo}" SelectionChanged="Cell_Changed" MaxDropDownHeight="280" IsEnabled="False"/>
                            <TextBlock x:Name="UnitText" Text="读取文件后选择需要安装的执行机构。" FontSize="10.5" Foreground="#5B6B7B" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="10,8">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="62"/><ColumnDefinition Width="6"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <TextBlock Text="02 / 外形预览" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="IsoButton" Grid.Column="1" Content="等轴测" Style="{StaticResource SecondaryButtonStyle}" Click="Iso_Click" Height="24" FontSize="10.5" Margin="0" Padding="3,0"/>
                                <Button x:Name="TopButton" Grid.Column="3" Content="俯视" Style="{StaticResource SecondaryButtonStyle}" Click="Top_Click" Height="24" FontSize="10.5" Margin="0" Padding="3,0"/>
                            </Grid>
                            <local:CelLibraryPreviewControl x:Name="CellPreview" Grid.Row="1" Margin="0,4,0,0"/>
                            <TextBlock x:Name="PreviewText" Grid.Row="2" Text="选择单元后显示真实几何。" FontSize="10.5" Foreground="#5B6B7B" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="03 / 安装到阀门" Style="{StaticResource SectionTitleStyle}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="点击“开始放置”，再到模型中点选阀门，按官方提示调整方向并确认。右键可结束。"/>
                            <TextBlock Text="安装位置沿用所选 CEL 的原点。以齿轮箱执行机构为基准，保留官方阀门交互。" Margin="0,8,0,0" Foreground="#5B6B7B"/>
                            <TextBlock Text="外形按开始放置时的版本保存；以后换选其他 CEL，不会改变已放置件。" Margin="0,8,0,0" Foreground="#5B6B7B"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="OperationCard" Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,6,6,0">
                <StackPanel>
                    <TextBlock x:Name="PlacementStateText" Text="请先选择 CEL 文件及库内单元。" FontSize="11" Foreground="#5B6B7B" Margin="0,0,0,6" TextWrapping="Wrap" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                        <Button x:Name="StartButton" Content="开始放置" Style="{StaticResource PrimaryButtonStyle}" Click="Start_Click" IsEnabled="False" Height="36" Margin="0"/>
                        <Button x:Name="EndButton" Grid.Column="2" Content="结束" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" IsEnabled="False" Height="36" Margin="0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
