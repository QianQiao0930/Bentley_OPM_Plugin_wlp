            <DataTemplate x:Key="FeatureCardTemplate">
                <Grid Margin="0,0,0,6">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="2"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#1F6FEB" ShadowDepth="2" Direction="270" BlurRadius="8" Opacity="0.08"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Button x:Name="CardFace" Style="{StaticResource HomeCardButtonStyle}" Height="78" Padding="11,10,32,9" IsEnabled="{Binding IsReady}" Click="SelectCard_Click" GotKeyboardFocus="Card_Focused" MouseDoubleClick="Card_DoubleClick" ToolTip="{Binding UsageText}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RankBadge" Width="24" Height="20" Margin="0,9,8,0" VerticalAlignment="Top" CornerRadius="4" Background="#F1F4F7" Visibility="Collapsed">
                                <TextBlock x:Name="RankText" Text="{Binding RankLabel}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1" x:Name="IconChip" Width="38" Height="38" CornerRadius="6" Background="#EAF2FF" BorderBrush="#D6E5FB" BorderThickness="1" VerticalAlignment="Top">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="IconGlyph" Data="{Binding IconGeometry}" Style="{StaticResource HomeIconGlyphStyle}"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#EEF2F6" BorderBrush="#E8EDF2" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Code}" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold" Foreground="#5B6B7B"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Foreground="#1B2733" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Title,Mode=OneWay}"/>
                                        <InlineUIContainer BaselineAlignment="Center">
                                            <Border x:Name="HotBadge" Visibility="Collapsed" Background="#FDECEC" BorderBrush="#F7D0D2" BorderThickness="1" CornerRadius="2" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="HOT" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" FontWeight="Bold" Foreground="#D9434A"/>
                                            </Border>
                                        </InlineUIContainer>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#5B6B7B" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <ProgressBar x:Name="UsageBar" Style="{StaticResource HomeMeter}" Width="56" Height="6" Value="{Binding UsageRatio,Mode=OneWay}" Maximum="100" Foreground="#1F6FEB" Background="#EDF1F5" BorderThickness="0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UseCount}" FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                    <TextBlock Text="次" FontSize="9.5" Foreground="#94A3B3" Margin="1,0,0,0"/>
                                    <TextBlock Text="{Binding MonthUsageText}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#94A3B3" Margin="6,0,0,0"/>
                                    <TextBlock Text="{Binding LastUsedText}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#94A3B3" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="StarButton" Style="{StaticResource HomeButton}" Width="26" Height="26" Padding="0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,4,0" IsEnabled="{Binding IsReady}" Click="Star_Click" ContextMenuOpening="Star_MenuOpening" ToolTip="设置1～5星；3星及以上置顶">
