<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.AboutPage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/PrototypeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:PrototypeChrome Title="联系作者" Code="BY" Caption="HOME / 关于 / 版本信息 · 问题反馈" Icon="M2,4 H22 V20 H2 Z M2,4 L12,13 L22,4"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="1" Margin="16,12,10,12">
            <StackPanel Margin="0">
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                            <TextBlock Text="关于软件" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12">
                            <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="44" Height="44" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left" Margin="0,0,0,12">
                                <Viewbox Margin="7">
                                    <Path Data="{StaticResource QBrandIcon}" Fill="Black"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="型钢构件及支吊架模型生成工具" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Background="{StaticResource CardSoftBrush}" CornerRadius="5" Padding="10,5">
                                    <TextBlock x:Name="VersionText" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock x:Name="AuthorText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                            <TextBlock Text="联系作者" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12">
                            <TextBlock x:Name="ContactPurposeText" Text="反馈问题 · 提出建议 · 申请激活码或试用码" TextWrapping="Wrap"/>
                            <TextBox x:Name="EmailText" IsReadOnly="True" Margin="0,12,0,12" FontSize="12.5"/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Content="复制邮箱" Style="{StaticResource PrimaryButtonStyle}" Margin="0" Click="CopyEmail_Click" Grid.Column="0"/>
                                <Button Content="打开邮件" Style="{StaticResource SecondaryButtonStyle}" Margin="0" Click="OpenEmail_Click" Grid.Column="2"/>
                            </Grid>
                            <TextBlock Text="反馈问题时，请附上软件版本、操作步骤和截图，便于定位。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="LicensingCard" Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                            <TextBlock Text="授权与试用" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12">
                            <TextBlock Text="永久激活码：申请时请附上本机机器码。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="试用码：无需机器码，可申请一个自然月或 90 天，从作者签发时刻起计时。" TextWrapping="Wrap"/>
                            <Button Content="进入激活页面" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenActivation_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
