<UserControl x:Class="SteelSectionProbe.AboutPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,8,0,0">
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="关于软件" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="型钢构件及支吊架模型生成工具" FontSize="18"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Background="{StaticResource CardSoftBrush}" CornerRadius="5" Padding="10,5">
                            <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock x:Name="AuthorText" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="联系作者" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="ContactPurposeText" Text="反馈问题 · 提出建议 · 申请激活码或试用码" TextWrapping="Wrap" />
                    <TextBox x:Name="EmailText" IsReadOnly="True" Margin="0,12,0,12" FontSize="15" />
                    <WrapPanel>
                        <Button Content="复制邮箱" Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,8" Click="CopyEmail_Click" />
                        <Button Content="打开邮件" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,0,8" Click="OpenEmail_Click" />
                    </WrapPanel>
                    <TextBlock Text="反馈问题时，请附上软件版本、操作步骤和截图，便于定位。"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="LicensingCard" Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="授权与试用" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="永久激活码：申请时请附上本机机器码。"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="试用码：无需机器码，可申请一个自然月或 90 天，从作者签发时刻起计时。"
                               TextWrapping="Wrap" />
                    <Button Content="进入激活页面" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenActivation_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
