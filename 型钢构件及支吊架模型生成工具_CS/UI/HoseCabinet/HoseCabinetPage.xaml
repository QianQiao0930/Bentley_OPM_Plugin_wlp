<UserControl x:Class="SteelSectionProbe.HoseCabinetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal" Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Themes/Theme.xaml"/>
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <TabControl x:Name="PageTabs" SelectionChanged="Tab_Changed">
        <TabItem Header="生成柜体">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="01  选型与方向" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="点取柜底前侧中心；0° 时正面朝 −Y。尺寸单位为 mm。" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="柜宽"/><TextBox x:Name="WidthText" Text="550" TextChanged="Parameter_Changed"/>
                                    <TextBlock Text="柜高" Margin="0,12,0,0"/><TextBox x:Name="HeightText" Text="1200" TextChanged="Parameter_Changed"/>
                                    <TextBlock Text="灭火器型号" Margin="0,12,0,0"/><TextBox x:Name="ModelText" Text="MFZ/ABC4" TextChanged="Parameter_Changed"/>
                                    <TextBlock Text="旋转角度（°）" Margin="0,12,0,0"/><TextBox x:Name="HeadingText" Text="0" TextChanged="Parameter_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="进深"/><TextBox x:Name="DepthText" Text="160" TextChanged="Parameter_Changed"/>
                                    <TextBlock Text="下部储物区高度" Margin="0,12,0,0"/><TextBox x:Name="LowerText" Text="550" TextChanged="Parameter_Changed"/>
                                    <TextBlock Text="灭火器数量（具）" Margin="0,12,0,0"/><TextBox x:Name="QuantityText" Text="2" TextChanged="Parameter_Changed"/>
                                    <CheckBox x:Name="EquipmentCheck" Content="生成卷盘、接口及箱内设备" IsChecked="True" Margin="0,24,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="SpecificationText" TextWrapping="Wrap" Margin="0,16,0,0"/>
                            <TextBlock x:Name="InteriorText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,8,4,0">
                    <StackPanel>
                        <TextBlock Text="02  点取与预览" Style="{StaticResource SectionTitleStyle}"/>
                        <WrapPanel>
                            <Button Content="开始点取" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0,0,8,8"/>
                            <Button Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" Margin="0,0,8,8"/>
                            <Button x:Name="UpdateButton" Content="更新预览" Style="{StaticResource SecondaryButtonStyle}" Click="Update_Click" Margin="0,0,8,8"/>
                        </WrapPanel>
                        <TextBlock x:Name="PreviewText" Text="尚未点取放置点。" TextWrapping="Wrap" Margin="0,4,0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消预览" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0,0,8,0"/>
                            <Button x:Name="ConfirmButton" Content="确定生成" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="统计与导出">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <WrapPanel>
                        <Button Content="统计当前 DGN" Style="{StaticResource PrimaryButtonStyle}" Click="Statistics_Click" Margin="0,0,8,8"/>
                        <Button x:Name="ExcelButton" Content="导出 Excel" Style="{StaticResource SecondaryButtonStyle}" Click="Excel_Click" IsEnabled="False" Margin="0,0,8,8"/>
                        <Button x:Name="JsonButton" Content="导出 JSON" Style="{StaticResource SecondaryButtonStyle}" Click="Json_Click" IsEnabled="False" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="TotalsText" Text="尚未统计。" TextWrapping="Wrap" Margin="0,4,0,12"/>
                </StackPanel>
                <DataGrid x:Name="SummaryGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="柜体规格" Binding="{Binding Specification}" Width="*"/>
                        <DataGridTextColumn Header="灭火器选型" Binding="{Binding ExtinguisherModel}" Width="*"/>
                        <DataGridTextColumn Header="柜数" Binding="{Binding CabinetCount}" Width="60"/>
                        <DataGridTextColumn Header="配置具数" Binding="{Binding ExtinguisherCount}" Width="75"/>
                        <DataGridTextColumn Header="记录模型" Binding="{Binding ActualExtinguisherCount}" Width="75"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
