<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.HoseCabinetPage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/ModelingTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <proto:PrototypeChrome Title="轻便消防水龙柜" Code="P380" Caption="HOME / 建模 / 卷盘设备 · 生成 · 消防统计" Icon="M3,1 H19 V23 H3 Z M3,9 H19 M3,17 H19 M7,5 H15" Accent="#1F6FEB" IconBackground="#EAF2FF" IconBorder="#D3E2FF"/>
        <TabControl x:Name="PageTabs" SelectionChanged="Tab_Changed" Grid.Row="1" Margin="16,12,10,12" Style="{StaticResource ModelTabs}">
            <TabItem Header="生成柜体" Style="{StaticResource ModelTab}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                        <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                            <StackPanel>
                                <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                        <Run Text="01 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                        <Run Text="选型与方向" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                    </TextBlock>
                                </Border>
                                <StackPanel Margin="12">
                                    <TextBlock Text="点取柜底前侧中心；0° 时正面朝 −Y。尺寸单位为 mm。" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="柜宽" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="WidthText" Text="550" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                            <TextBlock Text="柜高" Margin="0,12.0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="HeightText" Text="1200" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                            <TextBlock Text="灭火器型号" Margin="0,12.0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="ModelText" Text="MFZ/ABC4" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                            <TextBlock Text="旋转角度（°）" Margin="0,12.0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="HeadingText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="进深" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="DepthText" Text="160" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                            <TextBlock Text="下部储物区高度" Margin="0,12.0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="LowerText" Text="550" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                            <TextBlock Text="灭火器数量（具）" Margin="0,12.0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="QuantityText" Text="2" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                            <CheckBox x:Name="EquipmentCheck" Content="生成卷盘、接口及箱内设备" IsChecked="True" Margin="0,24,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Style="{StaticResource ModelCheck}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="SpecificationText" TextWrapping="Wrap" Margin="0,16,0,0"/>
                                    <TextBlock x:Name="InteriorText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,8,4,0" Padding="0">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="02 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="点取与预览" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <Button Content="开始点取" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="32"/>
                                    <Button Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" Margin="0" Grid.Column="2" Grid.Row="0" Height="32"/>
                                    <Button x:Name="UpdateButton" Content="更新预览" Style="{StaticResource SecondaryButtonStyle}" Click="Update_Click" Margin="0" Grid.Column="4" Grid.Row="0" Height="32"/>
                                </Grid>
                                <TextBlock x:Name="PreviewText" Text="尚未点取放置点。" TextWrapping="Wrap" Margin="0,4,0,12" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" MaxHeight="70" TextTrimming="CharacterEllipsis"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36"/>
                                    </Grid.RowDefinitions>
                                    <Button Content="取消预览" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="36"/>
                                    <Button x:Name="ConfirmButton" Content="确定生成" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsEnabled="False" Grid.Column="2" Grid.Row="0" Margin="0" Height="36"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="统计与导出" Style="{StaticResource ModelTab}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <Button Content="统计当前 DGN" Style="{StaticResource PrimaryButtonStyle}" Click="Statistics_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="32"/>
                            <Button x:Name="ExcelButton" Content="导出 Excel" Style="{StaticResource SecondaryButtonStyle}" Click="Excel_Click" IsEnabled="False" Margin="0" Grid.Column="2" Grid.Row="0" Height="32"/>
                            <Button x:Name="JsonButton" Content="导出 JSON" Style="{StaticResource SecondaryButtonStyle}" Click="Json_Click" IsEnabled="False" Margin="0" Grid.Column="4" Grid.Row="0" Height="32"/>
                        </Grid>
                        <TextBlock x:Name="TotalsText" Text="尚未统计。" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    </StackPanel>
                    <DataGrid x:Name="SummaryGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource ModelGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="柜体规格" Binding="{Binding Specification}" Width="*" MinWidth="130"/>
                            <DataGridTextColumn Header="灭火器选型" Binding="{Binding ExtinguisherModel}" Width="*" MinWidth="130"/>
                            <DataGridTextColumn Header="柜数" Binding="{Binding CabinetCount}" Width="60" MinWidth="60"/>
                            <DataGridTextColumn Header="配置具数" Binding="{Binding ExtinguisherCount}" Width="75" MinWidth="75"/>
                            <DataGridTextColumn Header="记录模型" Binding="{Binding ActualExtinguisherCount}" Width="75" MinWidth="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
