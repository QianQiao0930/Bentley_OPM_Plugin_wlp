<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SteelSectionProbe"
             x:Class="SteelSectionProbe.CelLibraryPage" x:ClassModifier="internal" Tag="prototype-v4" Background="#F4F7FA"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Prototype/ModelingTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="95"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <local:PrototypeChrome x:Name="PageChrome" Title="CEL 构件库放置" Code="CEL" Caption="HOME / 建模 / 构件库"
            Accent="#1F6FEB" IconBackground="#EAF2FF" IconBorder="#CADFFB" Icon="M2,7 L12,2 22,7 12,12 Z M2,12 L12,17 22,12 M2,17 L12,22 22,17"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="182"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="LibraryCard" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,0,6,8">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="64"/><ColumnDefinition Width="6"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LibraryCountText" Text="01 / 单元库 · 未读取" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1F6FEB" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="选择库" Style="{StaticResource SecondaryButtonStyle}" Click="Browse_Click" Height="28" Margin="0"/>
                        <Button x:Name="RefreshLibraryButton" Grid.Column="3" Content="刷新" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshLibrary_Click" Height="28" Margin="0"/>
                    </Grid>
                    <TextBlock x:Name="LibraryPathText" Text="默认读取 DLL 旁的 地面冲洗水盘管.cel" FontSize="10.5" Foreground="#5B6B7B" Margin="0,3,0,5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                    <ComboBox x:Name="CellCombo" DisplayMemberPath="DisplayName" Style="{StaticResource ModelCombo}" SelectionChanged="Cell_Changed" MaxDropDownHeight="280"/>
                </StackPanel>
            </Border>
            <Border x:Name="PreviewCard" Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,0,6,8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/><RowDefinition Height="20"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="62"/><ColumnDefinition Width="6"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                        <TextBlock Text="02 / 构件预览" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="IsoViewButton" Grid.Column="1" Content="等轴测" Style="{StaticResource SecondaryButtonStyle}" Click="IsoView_Click" Height="24" FontSize="10.5" Margin="0" Padding="3,0"/>
                        <Button x:Name="TopViewButton" Grid.Column="3" Content="俯视" Style="{StaticResource SecondaryButtonStyle}" Click="TopView_Click" Height="24" FontSize="10.5" Margin="0" Padding="3,0"/>
                    </Grid>
                    <local:CelLibraryPreviewControl x:Name="CellPreview" Grid.Row="1" Margin="0,3,0,0"/>
                    <TextBlock x:Name="PreviewInfoText" Grid.Row="2" Text="选择单元后显示真实几何" FontSize="10.5" Foreground="#5B6B7B" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                </Grid>
            </Border>
            <ScrollViewer x:Name="ParameterScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="03 / 放置方向" Style="{StaticResource SectionTitleStyle}" FontSize="12" Margin="0,0,0,6"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="60"/><ColumnDefinition Width="6"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="AngleText" Text="0" Style="{StaticResource ModelInput}" TextChanged="Angle_Changed" ToolTip="绕世界 +Z 轴逆时针的角度（度）；中心轴始终竖直向上。"/>
                                <Button x:Name="MinusAngleButton" Grid.Column="2" Content="−90°" Style="{StaticResource SecondaryButtonStyle}" Click="MinusAngle_Click" Height="34" Margin="0"/>
                                <Button x:Name="PlusAngleButton" Grid.Column="4" Content="+90°" Style="{StaticResource SecondaryButtonStyle}" Click="PlusAngle_Click" Height="34" Margin="0"/>
                            </Grid>
                            <TextBlock x:Name="DirectionText" Text="中心轴固定 +Z；点击位置为 CEL 自带原点。" FontSize="10.5" Foreground="#5B6B7B" Margin="0,6,0,0"/>
                            <Expander x:Name="MetadataExpander" Header="构件附加项" FontSize="11" Margin="0,8,0,0">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="构件类别" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBox x:Name="CategoryText" Text="地面冲洗水盘管" Style="{StaticResource ModelInput}" TextChanged="Metadata_Changed" MaxLength="120"/>
                                    <TextBlock Text="规格型号（可选）" FontSize="11" Margin="0,8,0,4"/>
                                    <TextBox x:Name="SpecificationText" Style="{StaticResource ModelInput}" TextChanged="Metadata_Changed" MaxLength="160"/>
                                    <TextBlock Text="每次放置一整套，附加项数量为 1。" FontSize="10.5" Foreground="#5B6B7B" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="10,8">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions>
                                <TextBlock Text="04 / 已放置构件统计" Style="{StaticResource SectionTitleStyle}" FontSize="12" Margin="0" VerticalAlignment="Center"/>
                                <Button x:Name="ExportButton" Grid.Column="1" Content="导出" Style="{StaticResource SecondaryButtonStyle}" Click="Export_Click" Height="28" Margin="0" IsEnabled="False"/>
                            </Grid>
                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="StatsScopeCombo" Style="{StaticResource ModelCombo}" SelectedIndex="0" SelectionChanged="StatsScope_Changed"><ComboBoxItem Content="活动模型"/><ComboBoxItem Content="当前 DGN 全部模型"/></ComboBox>
                                <Button x:Name="ReadStatisticsButton" Grid.Column="2" Content="刷新统计" Style="{StaticResource SecondaryButtonStyle}" Click="ReadStatistics_Click" Height="34" Margin="0"/>
                            </Grid>
                            <TextBlock x:Name="StatisticsCountText" Text="尚未统计" FontSize="12" FontWeight="SemiBold" Foreground="#1F6FEB" Margin="0,8,0,5"/>
                            <TextBox x:Name="StatisticsText" Text="统计当前模型中带本功能附加项的构件；参考文件不计入。" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="90" MaxHeight="200" Background="Transparent" BorderThickness="0" Padding="0" FontSize="11" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="OperationCard" Grid.Row="3" Style="{StaticResource CardStyle}" Padding="10,8" Margin="0,6,6,0">
                <StackPanel>
                    <TextBlock x:Name="PlacementStateText" Text="选择构件后开始放置。" FontSize="11" Foreground="#5B6B7B" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" MaxHeight="28" LineHeight="14" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
                        <Button x:Name="StartButton" Content="开始连续放置" Style="{StaticResource PrimaryButtonStyle}" Click="Start_Click" IsEnabled="False" Height="36" Margin="0"/>
                        <Button x:Name="EndButton" Grid.Column="2" Content="结束" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" IsEnabled="False" Height="36" Margin="0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
