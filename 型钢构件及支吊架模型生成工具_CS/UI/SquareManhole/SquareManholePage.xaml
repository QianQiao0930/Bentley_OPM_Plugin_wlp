<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.SquareManholePage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/ModelingTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <proto:PrototypeChrome Title="方形人孔" Code="SMH" Caption="HOME / 建模 / 筒体净空 · 盖板外形" Icon="M2,2 H20 V20 H2 Z M6,6 H16 V16 H6 Z" Accent="#1F6FEB" IconBackground="#EAF2FF" IconBorder="#D3E2FF"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="01 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="筒体净空尺寸" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock Text="净长（mm）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                <TextBox x:Name="BarrelWidthText" Text="600" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                <TextBlock Text="净宽（mm）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                <TextBox x:Name="BarrelDepthText" Text="600" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                <TextBlock Text="高度（mm）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                <TextBox x:Name="BarrelHeightText" Text="100" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="02 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="盖板外形尺寸" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock Text="外形长（mm）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                <TextBox x:Name="CoverWidthText" Text="620" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                <TextBlock Text="外形宽（mm）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                <TextBox x:Name="CoverDepthText" Text="620" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                <TextBlock Text="外形高（mm）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                <TextBox x:Name="CoverHeightText" Text="40" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                <TextBlock Text="壁厚（mm）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                <TextBox x:Name="WallText" Text="4" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                <TextBlock Text="朝向角（°）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                <TextBox x:Name="RotationText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                <TextBlock x:Name="SpecificationText" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="PreviewText" Text="尚未点取筒体下口中心。" TextWrapping="Wrap" Margin="12" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" MaxHeight="70" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>
                <Button Content="开始点取" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="32"/>
                <Button Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" Margin="0" Grid.Column="2" Grid.Row="0" Height="32"/>
                <Button x:Name="UpdateButton" Content="更新预览" Style="{StaticResource SecondaryButtonStyle}" Click="Update_Click" Margin="0" Grid.Column="4" Grid.Row="0" Height="32"/>
                <Grid Grid.Row="2" Grid.ColumnSpan="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="取消预览" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0" Grid.Column="0" Height="36"/>
                    <Button x:Name="ConfirmButton" Content="确认生成" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsEnabled="False" Margin="0" Grid.Column="2" Height="36"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
