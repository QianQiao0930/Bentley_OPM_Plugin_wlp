<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.N1CantileverPage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/SupportTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <proto:PrototypeChrome Title="N1 单悬臂架" Code="N1" Caption="HOME / 支吊架 / 参数设置 · 点取与预览" Icon="M13.73 4 A2 2 0 0 0 10.27 4 L2.27 18 A2 2 0 0 0 4 21 H20 A2 2 0 0 0 21.73 18 Z" Accent="#0E9F9A" IconBackground="#E6F6F5" IconBorder="#C7EAE8"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="01 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="设备上生根的单悬臂架" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock x:Name="InstructionText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="类型" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="TypeCombo" SelectionChanged="Type_Changed" Style="{StaticResource ModelCombo}">
                                            <ComboBoxItem Content="类型 1：单横担"/>
                                            <ComboBoxItem Content="类型 2：横担 + 端部构件 B"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="子项" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="SubtypeCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}">
                                            <ComboBoxItem Content="A"/>
                                            <ComboBoxItem Content="B"/>
                                            <ComboBoxItem Content="C"/>
                                            <ComboBoxItem Content="D"/>
                                            <ComboBoxItem Content="E"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="SectionText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="02 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="设备与构件尺寸（mm）" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel x:Name="EquipmentPanel">
                                            <TextBlock Text="设备外径 2R" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="EquipmentOdText" Text="2000" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel x:Name="PreweldPanel">
                                            <TextBlock Text="设备预焊件长度 D" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="PreweldText" Text="200" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        </StackPanel>
                                        <StackPanel x:Name="L2Panel" Margin="0,8,0,0">
                                            <TextBlock Text="构件 B 长度 L2（≤600）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                            <TextBox x:Name="L2Text" Text="300" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="ShowPreweldCheck" Content="生成预焊件占位（75% 透明，不计入清单）" Margin="0,8,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Style="{StaticResource ModelCheck}"/>
                                <CheckBox x:Name="ReverseCheck" Content="反转辅助线方向" Margin="0,8,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Style="{StaticResource ModelCheck}"/>
                                <TextBlock x:Name="DimensionsText" Text="请选择悬臂辅助线（L1）。" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock x:Name="LoadNoteText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Style="{StaticResource CardStyle}" Grid.Row="1" Margin="0,10,0,0" Padding="0">
                <StackPanel>
                    <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                            <Run Text="03 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                            <Run Text="点取与预览" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                        </TextBlock>
                    </Border>
                    <StackPanel Margin="12">
                        <TextBlock Text="点选辅助线自动生成预览；修改参数后更新预览。右键、取消或离开页面会清理未确认预览；辅助线保留。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <Button Content="点取辅助线" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="32"/>
                            <Button Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" Margin="0" Grid.Column="2" Grid.Row="0" Height="32"/>
                            <Button x:Name="UpdateButton" Content="更新预览" Style="{StaticResource SecondaryButtonStyle}" Click="Update_Click" Margin="0" Grid.Column="4" Grid.Row="0" Height="32"/>
                        </Grid>
                        <TextBlock x:Name="PreviewText" Text="尚未点取辅助线。" TextWrapping="Wrap" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" MaxHeight="42" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,6,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <Button Content="取消预览" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="36"/>
                            <Button x:Name="ConfirmButton" Content="确定生成" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" Grid.Column="2" Grid.Row="0" Margin="0" Height="36"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
