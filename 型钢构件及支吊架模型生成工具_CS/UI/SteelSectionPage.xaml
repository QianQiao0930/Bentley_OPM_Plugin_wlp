<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SteelSectionProbe.UI" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.SteelSectionPage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Prototype/ModelingTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <proto:PrototypeChrome Title="型钢生成" Code="STL" Caption="HOME / 建模 / 截面放置 · 路径扫掠" Icon="M2,2 H20 M2,20 H20 M6,2 V20 M16,2 V20 M6,10 H16" Accent="#1F6FEB" IconBackground="#EAF2FF" IconBorder="#D3E2FF"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="01 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="型钢规格与放置基准" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="42"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="型钢类型" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="FamilyCombo" Grid.Row="0" Grid.Column="1" SelectionChanged="FamilyCombo_SelectionChanged" Style="{StaticResource ModelCombo}"/>
                                    <TextBlock Grid.Row="1" Text="规格" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="ProfileCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="ProfileCombo_SelectionChanged" Style="{StaticResource ModelCombo}"/>
                                    <TextBlock Grid.Row="2" Text="插入基准" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="ModeCombo" Grid.Row="2" Grid.Column="1" SelectionChanged="ModeCombo_SelectionChanged" Style="{StaticResource ModelCombo}"/>
                                    <TextBlock Grid.Row="3" Text="截面旋转" Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid Grid.Row="3" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="RotationTextBox" Text="0.0" HorizontalContentAlignment="Right" PreviewTextInput="RotationTextBox_PreviewTextInput" TextChanged="RotationTextBox_TextChanged" LostFocus="RotationTextBox_LostFocus" Style="{StaticResource ModelInput}"/>
                                        <TextBlock Grid.Column="1" Text="°（路径扫掠）" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="02 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="当前截面参数" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock x:Name="ProfileSummaryText" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource InkBrush}"/>
                                <ItemsControl x:Name="DimensionItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10.5" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="实时截面预览" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,5"/>
                                <local:ProfilePreviewControl x:Name="ProfilePreview" Height="118"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Style="{StaticResource CardStyle}" Grid.Row="1" Margin="0,10,0,0" Padding="0">
                <StackPanel>
                    <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                            <Run Text="03 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                            <Run Text="创建方式" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                        </TextBlock>
                    </Border>
                    <StackPanel Margin="12">
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="放置二维截面" FontWeight="SemiBold"/>
                                <TextBlock Text="在活动视图中动态预览并连续放置闭合截面。" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="PlaceButton" Grid.Column="1" Content="在视图中放置" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Click="PlaceButton_Click"/>
                        </Grid>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,7"/>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="沿路径生成实体" FontWeight="SemiBold"/>
                                <TextBlock Text="点选开放路径，生成三维实体预览后确认。" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="SweepButton" Grid.Column="1" Content="选取路径" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="SweepButton_Click"/>
                        </Grid>
                        <CheckBox x:Name="DeletePathCheckBox" Content="确认扫掠后删除源路径" Margin="0,1,0,8" Style="{StaticResource ModelCheck}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                            </Grid.RowDefinitions>
                            <Button x:Name="CancelButton" Content="取消预览" Style="{StaticResource SecondaryButtonStyle}" Margin="0" Click="CancelButton_Click" Grid.Column="0" Grid.Row="0" Height="36"/>
                            <Button x:Name="ConfirmButton" Content="确定保留" Style="{StaticResource PrimaryButtonStyle}" Click="ConfirmButton_Click" Grid.Column="2" Grid.Row="0" Margin="0" Height="36"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
