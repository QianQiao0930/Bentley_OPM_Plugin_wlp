<UserControl x:Class="SteelSectionProbe.SteelSectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SteelSectionProbe.UI"
             x:ClassModifier="internal"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
        <StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="01  型钢规格与放置基准"
                               Style="{StaticResource SectionTitleStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="型钢类型" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="FamilyCombo" Grid.Row="0" Grid.Column="1"
                                  SelectionChanged="FamilyCombo_SelectionChanged" />

                        <TextBlock Grid.Row="1" Text="规格" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="ProfileCombo" Grid.Row="1" Grid.Column="1"
                                  SelectionChanged="ProfileCombo_SelectionChanged" />

                        <TextBlock Grid.Row="2" Text="插入基准" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="ModeCombo" Grid.Row="2" Grid.Column="1"
                                  SelectionChanged="ModeCombo_SelectionChanged" />

                        <TextBlock Grid.Row="3" Text="截面旋转" Style="{StaticResource FieldLabelStyle}" />
                        <Grid Grid.Row="3" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RotationTextBox" Text="0.0"
                                     HorizontalContentAlignment="Right"
                                     PreviewTextInput="RotationTextBox_PreviewTextInput"
                                     TextChanged="RotationTextBox_TextChanged"
                                     LostFocus="RotationTextBox_LostFocus" />
                            <TextBlock Grid.Column="1" Text="°（路径扫掠）"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="02  创建方式" Style="{StaticResource SectionTitleStyle}" />

                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="放置二维截面" FontWeight="SemiBold" />
                            <TextBlock Text="在活动视图中动态预览并连续放置闭合截面。"
                                       FontSize="10" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="PlaceButton" Grid.Column="1" Content="在视图中放置"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center" Click="PlaceButton_Click" />
                    </Grid>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Margin="0,0,0,7" />

                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="沿路径生成实体" FontWeight="SemiBold" />
                            <TextBlock Text="点选开放路径，生成三维实体预览后确认。"
                                       FontSize="10" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="SweepButton" Grid.Column="1" Content="选取路径"
                                Style="{StaticResource SecondaryButtonStyle}"
                                VerticalAlignment="Center" Click="SweepButton_Click" />
                    </Grid>

                    <CheckBox x:Name="DeletePathCheckBox"
                              Content="确认扫掠后删除源路径"
                              Margin="0,1,0,8" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="取消预览"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,7,0" Click="CancelButton_Click" />
                        <Button x:Name="ConfirmButton" Content="确定保留"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ConfirmButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="03  当前截面参数" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="ProfileSummaryText"
                               FontWeight="SemiBold" Margin="0,0,0,6"
                               Foreground="{StaticResource InkBrush}" />

                    <ItemsControl x:Name="DimensionItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1" Padding="2,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10.5"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="实时截面预览" FontSize="10.5"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,9,0,5" />
                    <local:ProfilePreviewControl x:Name="ProfilePreview" Height="118" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
