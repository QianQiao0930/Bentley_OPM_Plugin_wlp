<UserControl x:Class="SteelSectionProbe.TankManholePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
             Background="{DynamicResource BackgroundBrush}"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="01  人孔规格" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="选择 DN 尺寸、压力等级与开盖形式。点取位置作为筒节在罐壁的中心。" Foreground="Black" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="公称管径" Foreground="Black" /><ComboBox x:Name="DnCombo" SelectionChanged="Parameter_Changed"><ComboBoxItem Content="DN450" /><ComboBoxItem Content="DN500" /><ComboBoxItem Content="DN600" /></ComboBox>
                            <TextBlock Text="开盖形式" Foreground="Black" Margin="0,8,0,0" /><ComboBox x:Name="ModeCombo" SelectionChanged="Parameter_Changed"><ComboBoxItem Content="吊杆式" /><ComboBoxItem Content="铰链式" /></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="压力等级" Foreground="Black" /><ComboBox x:Name="PressureCombo" SelectionChanged="Parameter_Changed"><ComboBoxItem Content="ASA 150 lbs" /><ComboBoxItem Content="ASA 300 lbs" /><ComboBoxItem Content="ASA 600 lbs" /></ComboBox>
                            <TextBlock Text="筒节长度（mm）" Foreground="Black" Margin="0,8,0,0" /><TextBox x:Name="NeckText" Text="150" LostFocus="Parameter_Changed" /></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="02  放置方向及附属件" Style="{StaticResource SectionTitleStyle}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="水平朝向角度（°；0 为 +X）" Foreground="Black" TextWrapping="Wrap" /><TextBox x:Name="HeadingText" Text="0" LostFocus="Parameter_Changed" />
                        <CheckBox x:Name="MirrorCheck" Content="反向放置（旋转 180°）" Margin="0,9,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" /></StackPanel>
                    <StackPanel Grid.Column="2"><CheckBox x:Name="BoltsCheck" Content="生成螺栓、垫圈和螺母" IsChecked="True" Checked="Parameter_Changed" Unchecked="Parameter_Changed" />
                        <CheckBox x:Name="LiftingCheck" Content="生成吊杆与调节件" IsChecked="True" Margin="0,9,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" /></StackPanel>
                </Grid>
                <TextBlock x:Name="SpecificationText" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="03  点取与放置" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="点击【点取位置】后：① 移动光标整套人孔跟随，左键定原点；② 再移动光标调整朝向（人孔朝向光标），再次左键直接放置。右键随时取消。可配合精确绘图键入距离与角度。" Foreground="Black" TextWrapping="Wrap" Margin="0,0,0,8" />
                <WrapPanel><Button Content="点取位置" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0,0,8,8" />
                    <Button Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" Margin="0,0,8,8" /></WrapPanel>
                <TextBlock x:Name="PreviewText" Text="尚未点取位置。" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
            </StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
