<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.ConicalVentCapPage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Prototype/ModelingTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="DiameterCombo" TargetType="ComboBox">
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#1B2733"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="B" CornerRadius="6" Background="White" BorderBrush="#DDE3EA" BorderThickness="1">
                                            <Grid Margin="8,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 2,5 L 7,10 L 12,5" Stroke="#94A3B3" StrokeThickness="1.6" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#B9CCE6"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#1F6FEB"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" Margin="8,0,27,0" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ClipToBounds="True"/>
                            <TextBox x:Name="PART_EditableTextBox" Margin="8,0,27,0" FontSize="12.5" Foreground="#1B2733" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" MinHeight="0" TextAlignment="Left" VerticalContentAlignment="Center" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,3,0,0">
                                    <ScrollViewer MaxHeight="300">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#1F6FEB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ResourceDictionary></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="95"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <proto:PrototypeChrome Title="锥形风帽" Code="FM" Caption="HOME / 建模 / 14K117-3 锥形风帽" Icon="M12,2 L22,20 H2 Z M5,23 H19" Accent="#1F6FEB" IconBackground="#EAF2FF" IconBorder="#D3E2FF"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0"><StackPanel>
                        <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8"><TextBlock Text="01 / 规格与参数" Style="{StaticResource SectionTitleStyle}" Margin="0"/></Border>
                        <StackPanel Margin="12">
                            <TextBlock Text="连接短管外径 D（mm）" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <ComboBox x:Name="DiameterText" IsEditable="True" SelectionChanged="Parameter_Changed" TextBoxBase.TextChanged="Parameter_Changed" Style="{StaticResource DiameterCombo}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="板厚（mm）" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ThicknessText" Text="2" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="支撑组数" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="SupportCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="绕竖轴旋转角（°）" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,5"/>
                            <TextBox x:Name="HeadingText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                            <TextBlock Text="按 14K117-3 第 3 页构造图、第 5 页尺寸表建模：底部接口平面中心为基点，+Z 向上；D 为连接短管外径，板厚向内生成。" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Padding="0"><StackPanel>
                        <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8"><TextBlock Text="02 / 当前结果" Style="{StaticResource SectionTitleStyle}" Margin="0"/></Border>
                        <StackPanel Margin="12">
                            <TextBlock x:Name="SpecificationText" TextWrapping="Wrap"/>
                            <TextBlock Text="整组封装为一个普通模型块，可整体移动、旋转和删除；外壳与接口件浅灰、件⑦/件⑧支撑深灰。" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="12"><StackPanel>
                <TextBlock Text="点取后预览；修改参数后更新预览，再确认生成。" Margin="0,0,0,8"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Content="开始点取" Click="Pick_Click" Style="{StaticResource PrimaryButtonStyle}" Height="32" Margin="0"/>
                    <Button Grid.Column="2" Content="结束点取" Click="End_Click" Style="{StaticResource SecondaryButtonStyle}" Height="32" Margin="0"/>
                    <Button Grid.Column="4" x:Name="UpdateButton" Content="更新预览" Click="Update_Click" Style="{StaticResource SecondaryButtonStyle}" Height="32" Margin="0"/>
                </Grid>
                <TextBlock x:Name="PreviewText" Text="尚未点取风帽底部接口中心。" Margin="0,8,0,10" MaxHeight="42" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Content="取消预览" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0"/>
                    <Button Grid.Column="2" x:Name="ConfirmButton" Content="确定生成" Click="Confirm_Click" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" Height="36" Margin="0"/>
                </Grid>
            </StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
