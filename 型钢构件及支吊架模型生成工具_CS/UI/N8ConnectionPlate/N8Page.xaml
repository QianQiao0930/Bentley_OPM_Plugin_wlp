<UserControl x:Class="SteelSectionProbe.N8Page"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:ClassModifier="internal" Background="{DynamicResource BackgroundBrush}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Themes/Theme.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <Border Style="{StaticResource CardStyle}"><StackPanel>
   <TextBlock Text="N8 设备预焊件连接板" Style="{StaticResource SectionTitleStyle}"/>
   <TextBlock Text="先设类型和工况，再点取连接板背面中心。" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="类型（表 1）"/><ComboBox x:Name="TypeCombo" SelectionChanged="Parameter_Changed"/>
     <TextBlock Text="工况" Margin="0,8,0,0"/><ComboBox x:Name="ModeCombo" SelectionChanged="Parameter_Changed"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="安装面"/><ComboBox x:Name="MountCombo" SelectionChanged="Parameter_Changed"/>
     <TextBlock Text="朝向角（度）" Margin="0,8,0,0"/><TextBox x:Name="HeadingText" Text="0" LostFocus="Parameter_Changed"/>
    </StackPanel>
   </Grid>
   <TextBlock x:Name="SpecText" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource CardStyle}"><StackPanel>
   <TextBlock Text="点取与预览" Style="{StaticResource SectionTitleStyle}"/>
   <WrapPanel>
    <Button Content="开始点取" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0,0,8,8"/>
    <Button Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" Margin="0,0,8,8"/>
    <Button Content="更新预览" Style="{StaticResource SecondaryButtonStyle}" Click="Update_Click" Margin="0,0,8,8"/>
   </WrapPanel>
   <TextBlock x:Name="PreviewText" Text="尚未点取位置。" TextWrapping="Wrap" Margin="0,4,0,12"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="取消预览" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0,0,8,0"/>
    <Button x:Name="ConfirmButton" Content="确定生成" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsEnabled="False"/>
   </StackPanel>
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
