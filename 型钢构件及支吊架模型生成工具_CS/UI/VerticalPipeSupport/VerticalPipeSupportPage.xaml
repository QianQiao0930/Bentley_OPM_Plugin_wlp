<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.VerticalPipeSupportPage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/SupportTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <proto:PrototypeChrome Title="立管耳轴" Code="F6/F7/F10" Caption="HOME / 支吊架 / 参数设置 · 点取与预览" Icon="M18 9 L12 3 L6 9 M12 3 V17 M5 21 H19" Accent="#0E9F9A" IconBackground="#E6F6F5" IconBorder="#C7EAE8"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="01 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="立管耳轴类型" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock Text="先选择类型，再设置参数并点取立管或竖直辅助线。F6 单耳轴、F7 双耳轴；F10 用于小管径立管耳板。" TextWrapping="Wrap" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                <ComboBox x:Name="KindCombo" SelectionChanged="Kind_Changed" Style="{StaticResource ModelCombo}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TrunnionPanel" Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="02 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="F6 / F7 耳轴参数" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="主管 DN（点取辅助线时使用）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="TrunnionPipeDn" SelectionChanged="PipeDn_Changed" Style="{StaticResource ModelCombo}"/>
                                        <TextBlock Text="耳轴 DN（表 1 候选）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="TrunnionDn" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                        <TextBlock Text="L：主管轴线至端板外端（mm）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="LengthText" Text="500" LostFocus="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        <TextBlock Text="耳轴壁厚（mm；留空为 STD）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="WallText" LostFocus="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="端板 A / B / C" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="EndTypeCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                        <TextBlock Text="材料代码" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="TrunnionMaterial" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                        <TextBlock Text="方位角（度；0° = +Y，顺时针）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TrunnionAngle" Text="0" LostFocus="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        <CheckBox x:Name="PadCheck" Content="生成补强板" Margin="0,8,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Style="{StaticResource ModelCheck}"/>
                                        <TextBlock Text="补强板厚度（mm）" Margin="0,6,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="PadThickness" Text="5" LostFocus="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="EarPlatePanel" Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="02 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="F10 小管径立管耳板参数" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="主管 DN（点取辅助线时使用）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="EarPipeDn" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                        <TextBlock Text="长度代码" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="EarLength" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                        <TextBlock Text="高度代码" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="EarHeight" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="材料代码" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="EarMaterial" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                        <TextBlock Text="方位角（度）" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="EarAngle" Text="0" LostFocus="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                        <CheckBox x:Name="FixedCheck" Content="固定 Y：开孔并配置 M12 螺栓" IsChecked="True" Margin="0,8,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Style="{StaticResource ModelCheck}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Style="{StaticResource CardStyle}" Grid.Row="1" Margin="0,10,0,0" Padding="0">
                <StackPanel>
                    <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                            <Run Text="03 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                            <Run Text="点取与预览" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                        </TextBlock>
                    </Border>
                    <StackPanel Margin="12">
                        <TextBlock Text="在模型中点取立管或竖直辅助线，点击位置确定耳轴标高；预览后可点「沿轴滑动」微调标高，左键锁定，右键取消。仅确认后写入支吊架清单。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <Button Content="开始点取" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="32"/>
                            <Button Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" Margin="0" Grid.Column="2" Grid.Row="0" Height="32"/>
                            <Button x:Name="UpdateButton" Content="更新预览" Style="{StaticResource SecondaryButtonStyle}" Click="Update_Click" Margin="0" Grid.Column="0" Grid.Row="2" Height="32"/>
                            <Button Content="沿轴滑动" Style="{StaticResource SecondaryButtonStyle}" Click="Slide_Click" Margin="0" Grid.Column="2" Grid.Row="2" Height="32"/>
                        </Grid>
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="沿轴偏移（mm，正值向上）" VerticalAlignment="Center" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AxisOffsetText" Text="0" TextChanged="AxisOffset_Changed" Margin="0" Style="{StaticResource ModelInput}"/>
                                <Button Content="应用偏移" Style="{StaticResource SecondaryButtonStyle}" Click="ApplyOffset_Click" Margin="0" Grid.Column="2"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock x:Name="AxisPositionText" Text="定位基点：尚未点取。" TextWrapping="Wrap" Margin="0,6,0,8" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" MaxHeight="42" TextTrimming="CharacterEllipsis" FontSize="11"/>
                        <TextBlock x:Name="PreviewText" Text="尚未点取立管。" TextWrapping="Wrap" Margin="0,6,0,12.0" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" MaxHeight="42" TextTrimming="CharacterEllipsis" FontSize="11"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <Button Content="取消预览" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="36"/>
                            <Button x:Name="ConfirmButton" Content="确定生成" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsEnabled="False" Grid.Column="2" Grid.Row="0" Margin="0" Height="36"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
