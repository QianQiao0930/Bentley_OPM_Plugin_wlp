<UserControl x:Class="SteelSectionProbe.VerticalPipeSupportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal" Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Themes/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="01  立管耳轴类型" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="先选择类型，再设置参数并点取立管或竖直辅助线。F6 单耳轴、F7 双耳轴；F10 用于小管径立管耳板。" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ComboBox x:Name="KindCombo" SelectionChanged="Kind_Changed" />
            </StackPanel></Border>
            <Border x:Name="TrunnionPanel" Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="02  F6 / F7 耳轴参数" Style="{StaticResource SectionTitleStyle}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="主管 DN（点取辅助线时使用）"/><ComboBox x:Name="TrunnionPipeDn" SelectionChanged="PipeDn_Changed"/>
                        <TextBlock Text="耳轴 DN（表 1 候选）" Margin="0,8,0,0"/><ComboBox x:Name="TrunnionDn" SelectionChanged="Parameter_Changed"/>
                        <TextBlock Text="L：主管轴线至端板外端（mm）" Margin="0,8,0,0"/><TextBox x:Name="LengthText" Text="500" LostFocus="Parameter_Changed"/>
                        <TextBlock Text="耳轴壁厚（mm；留空为 STD）" Margin="0,8,0,0"/><TextBox x:Name="WallText" LostFocus="Parameter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="端板 A / B / C"/><ComboBox x:Name="EndTypeCombo" SelectionChanged="Parameter_Changed"/>
                        <TextBlock Text="材料代码" Margin="0,8,0,0"/><ComboBox x:Name="TrunnionMaterial" SelectionChanged="Parameter_Changed"/>
                        <TextBlock Text="方位角（度；0° = +Y，顺时针）" Margin="0,8,0,0"/><TextBox x:Name="TrunnionAngle" Text="0" LostFocus="Parameter_Changed"/>
                        <CheckBox x:Name="PadCheck" Content="生成补强板" Margin="0,8,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed"/>
                        <TextBlock Text="补强板厚度（mm）" Margin="0,6,0,0"/><TextBox x:Name="PadThickness" Text="5" LostFocus="Parameter_Changed"/>
                    </StackPanel>
                </Grid>
            </StackPanel></Border>
            <Border x:Name="EarPlatePanel" Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="02  F10 小管径立管耳板参数" Style="{StaticResource SectionTitleStyle}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="主管 DN（点取辅助线时使用）"/><ComboBox x:Name="EarPipeDn" SelectionChanged="Parameter_Changed"/>
                        <TextBlock Text="长度代码" Margin="0,8,0,0"/><ComboBox x:Name="EarLength" SelectionChanged="Parameter_Changed"/>
                        <TextBlock Text="高度代码" Margin="0,8,0,0"/><ComboBox x:Name="EarHeight" SelectionChanged="Parameter_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="材料代码"/><ComboBox x:Name="EarMaterial" SelectionChanged="Parameter_Changed"/>
                        <TextBlock Text="方位角（度）" Margin="0,8,0,0"/><TextBox x:Name="EarAngle" Text="0" LostFocus="Parameter_Changed"/>
                        <CheckBox x:Name="FixedCheck" Content="固定 Y：开孔并配置 M12 螺栓" IsChecked="True" Margin="0,8,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed"/>
                    </StackPanel>
                </Grid>
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel>
                <TextBlock Text="03  点取与预览" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="在模型中点取立管或竖直辅助线，点击位置确定耳轴标高。仅确认后写入支吊架清单。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="开始点取" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0,0,8,8"/>
                    <Button Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="End_Click" Margin="0,0,8,8"/>
                    <Button Content="更新预览" Style="{StaticResource SecondaryButtonStyle}" Click="Update_Click" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock x:Name="PreviewText" Text="尚未点取立管。" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消预览" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ConfirmButton" Content="确定生成" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsEnabled="False"/>
                </StackPanel>
            </StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
