<UserControl x:Class="SteelSectionProbe.ComponentPropertiesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
             Background="{DynamicResource BackgroundBrush}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ResultTextStyle" TargetType="TextBox">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="5,3" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
            <Style x:Key="ResultHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="Background" Value="#F4F7FB" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="8,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Grid.Row="0">
            <StackPanel>
                <TextBlock Text="01  点取构件" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="将光标悬停在构件上，左键单击即读取特性。可连续点取；右键结束。"
                           TextWrapping="Wrap" Foreground="{StaticResource InkBrush}"
                           FontSize="11" Margin="0,0,0,10" />
                <WrapPanel>
                    <Button x:Name="PickButton" Content="点取构件" Style="{StaticResource PrimaryButtonStyle}"
                            Click="Pick_Click" Margin="0,0,8,0" />
                    <Button Content="结束点取" Style="{StaticResource SecondaryButtonStyle}"
                            Click="Stop_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}" Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="02  查询结果" Style="{StaticResource SectionTitleStyle}" />
                    <TextBox x:Name="SelectionText" Text="尚未点取构件"
                             Style="{StaticResource ResultTextStyle}" FontSize="13"
                             FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="属性单位" Style="{StaticResource FieldLabelStyle}"
                                   Foreground="#000000" />
                        <ComboBox x:Name="UnitCombo" Grid.Column="1"
                                  SelectionChanged="Unit_SelectionChanged">
                            <ComboBoxItem Content="自动判断" Tag="auto" IsSelected="True" />
                            <ComboBoxItem Content="毫米" Tag="mm" />
                            <ComboBoxItem Content="米" Tag="m" />
                        </ComboBox>
                    </Grid>
                    <WrapPanel>
                        <CheckBox x:Name="AllPropertiesCheck" Content="显示全部 EC 属性"
                                  Checked="View_Changed" Unchecked="View_Changed"
                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="CopyResultsButton" Content="复制查询结果"
                                Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                                Click="CopyResults_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Grid.Row="1" Padding="0" MinHeight="80">
                <DataGrid x:Name="ResultItems" AutoGenerateColumns="False"
                          HeadersVisibility="Column" RowHeaderWidth="0"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserResizeColumns="True"
                          IsReadOnly="True" SelectionUnit="Cell"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="#E9EDF3"
                          VerticalGridLinesBrush="#D8E0EA"
                          BorderThickness="0" Background="White" Foreground="Black"
                          RowBackground="White" AlternatingRowBackground="#FAFBFC"
                          ColumnHeaderStyle="{StaticResource ResultHeaderStyle}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="特性（拖动边界）"
                                                Width="150" MinWidth="90" MaxWidth="420">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Label}" Style="{StaticResource ResultTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="内容" Width="*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Value}" Style="{StaticResource ResultTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>