<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.ChimneyCablePage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/ModelingTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <proto:PrototypeChrome Title="烟囱拉索" Code="HZLS" Caption="HOME / 工程绘图 / 排气筒 · φ16 拉索 · 绳眼装配" Icon="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M7,21 V9 M17,21 V9 M7,9 H17 M3,21 L7,13 M21,21 L17,13" Accent="#1F6FEB" IconBackground="#EAF2FF" IconBorder="#D3E2FF"/>
        <TabControl x:Name="PageTabs" SelectionChanged="Tab_Changed" Grid.Row="1" Margin="16,12,10,12" Style="{StaticResource ModelTabs}">
            <TabItem Header="建模与预览" Style="{StaticResource ModelTab}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                                <StackPanel>
                                    <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                        <TextBlock Text="01 / 筒身与拉索" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                    </Border>
                                    <StackPanel Margin="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="排气筒高度 H（m）" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                <TextBox x:Name="HeightText" Text="30" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                                <TextBlock Text="1～300；拉索外圆半径按 2H/3 起算。" Foreground="#5B6B7B" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="筒壁厚度 t（mm）" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                <TextBox x:Name="WallThicknessText" Text="10" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                                <TextBlock Text="1～1000；须小于筒身半径。" Foreground="#5B6B7B" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="筒身直径 D（mm）" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                <TextBox x:Name="DiameterText" Text="1000" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                                <TextBlock Text="10～20000；R = D/2。" Foreground="#5B6B7B" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="拉索角度（°）" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                <TextBox x:Name="AngleText" Text="30" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                                <TextBlock Text="1～89；与竖直方向的夹角。" Foreground="#5B6B7B" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="绕竖轴旋转角（°）" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                <TextBox x:Name="HeadingText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="+90°" Click="RotatePlus_Click" Style="{StaticResource SecondaryButtonStyle}" Height="34" Margin="0" VerticalAlignment="Bottom" ToolTip="旋转角加 90°（结果归一到 0～360）"/>
                                            <Button Grid.Column="4" Content="−90°" Click="RotateMinus_Click" Style="{StaticResource SecondaryButtonStyle}" Height="34" Margin="0" VerticalAlignment="Bottom" ToolTip="旋转角减 90°（结果归一到 0～360）"/>
                                        </Grid>
                                        <CheckBox x:Name="CableCheck" Content="生成拉索（取消＝自立式：无拉索、环板、绳眼与地面吊环）" IsChecked="True" Checked="Toggle_Changed" Unchecked="Toggle_Changed" Style="{StaticResource ModelCheck}" Margin="0,12,0,0"/>
                                        <TextBlock Text="局部原点 = 筒身底部圆心，Z 向上；筒身按输入壁厚生成空心筒壁，拉索为 φ16 钢丝绳，两端带绳眼装配（鸡心环 + 3 只绳夹）；H/(2R) &gt; 35 时在 H/3 补挂中间层拉索。" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="0" VerticalAlignment="Top">
                                <StackPanel>
                                    <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                        <TextBlock Text="02 / 基础与检修门" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                    </Border>
                                    <StackPanel Margin="12">
                                        <CheckBox x:Name="BaseCheck" Content="生成混凝土基础、环形预埋板、地脚螺栓与检修门" IsChecked="True" Checked="Toggle_Changed" Unchecked="Toggle_Changed" Style="{StaticResource ModelCheck}"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="地脚螺栓个数" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                <TextBox x:Name="BoltCountText" Text="12" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                                <TextBlock Text="2～200；沿圆周均布。" Foreground="#5B6B7B" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="螺栓露出长度（mm）" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                <TextBox x:Name="AbovePlateText" Text="30" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                                <TextBlock Text="20～500；含螺母与丝扣。" Foreground="#5B6B7B" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="基础厚度（mm）" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                <TextBox x:Name="FoundationThicknessText" Text="200" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                                <TextBlock Text="160～5000；自预埋板底面向下。" Foreground="#5B6B7B" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="螺栓圆直径 D2（mm）" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                <TextBox x:Name="BoltCircleText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                                <TextBlock Text="0＝自动 D+350。" Foreground="#5B6B7B" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="预埋板直径 D3（mm）" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                                <TextBox x:Name="PlateDiameterText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                                <TextBlock Text="0＝自动 D+700。" Foreground="#5B6B7B" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="基础边长自动取 D3+200；检修门在 +Y 面、门底距风管底 400，风管外径不足 450 时不生成。" Margin="0,10,0,0" Foreground="#5B6B7B" FontSize="10.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="0">
                                <StackPanel>
                                    <Border MinHeight="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,8">
                                        <TextBlock Text="03 / 当前结果" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                    </Border>
                                    <StackPanel Margin="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="拉索外圆半径" Foreground="#5B6B7B" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OuterRadiusText" Text="—" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="拉索根数" Foreground="#5B6B7B" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CableCountText" Text="—" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="中间层拉索" Foreground="#5B6B7B" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ExtraLayerText" Text="—" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="基础与检修门" Foreground="#5B6B7B" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BaseText" Text="—" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="材料合计" Foreground="#5B6B7B"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TotalMassText" Text="—" FontWeight="SemiBold"/>
                                        </Grid>
                                        <TextBlock x:Name="SpecificationText" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                        <TextBlock Text="整组封装为一个普通模型块，可整体移动、旋转和删除。生成拉索时：上端通过环绕筒身的连接环板（外缘比筒身半径宽 100、厚 20，每根拉索 2 个 φ24 孔、孔心距外缘 50）与 M20 U 形螺栓挂接——两腿穿板后各用一个 M20 螺母压紧，板下弯钩吊住鸡心环，绳眼整体挂在环板下方、与板底留 11 以上净距；下端经埋入锚墩的 φ30 吊环固定（两腿净距 100、外露 100、埋深 900、底部 180° 回钩；两层时两个吊环沿拉索方向相距 300），绳眼为真圆弧链：φ16 绳圈放样成单一光滑管面，φ38 鸡心环为真圆弧链环带沿带宽方向拉伸；绳夹跨工作段与尾段（32×63 鞍座 + M14 U 形螺栓 + 螺母），夹距 6.5φ=104。取消拉索则自立，只留筒身与基础。" Margin="0,10,0,0" Foreground="#5B6B7B" FontSize="10.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="点取后预览；修改参数后更新预览，再确认生成。" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Content="开始点取" Click="Pick_Click" Style="{StaticResource PrimaryButtonStyle}" Height="32" Margin="0" Grid.Column="0"/>
                                <Button Grid.Column="2" Content="结束点取" Click="End_Click" Style="{StaticResource SecondaryButtonStyle}" Height="32" Margin="0"/>
                                <Button Grid.Column="4" x:Name="UpdateButton" Content="更新预览" Click="Update_Click" Style="{StaticResource SecondaryButtonStyle}" Height="32" Margin="0"/>
                            </Grid>
                            <TextBlock x:Name="PreviewText" Text="尚未点取筒身底部圆心。" Margin="0,8,0,10" MaxHeight="42" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Content="取消预览" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0"/>
                                <Button Grid.Column="2" x:Name="ConfirmButton" Content="确定生成" Click="Confirm_Click" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" Height="36" Margin="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="材料统计" Style="{StaticResource ModelTab}">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <Button Content="刷新统计" ToolTip="按当前参数重新计算材料用量" Style="{StaticResource PrimaryButtonStyle}" Click="Materials_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="32"/>
                            <Button x:Name="ExcelButton" Content="导出 Excel" Style="{StaticResource SecondaryButtonStyle}" Click="Excel_Click" IsEnabled="False" Margin="0" Grid.Column="2" Grid.Row="0" Height="32"/>
                            <Button x:Name="JsonButton" Content="导出 JSON" Style="{StaticResource SecondaryButtonStyle}" Click="Json_Click" IsEnabled="False" Margin="0" Grid.Column="4" Grid.Row="0" Height="32"/>
                        </Grid>
                        <TextBlock x:Name="TotalsText" Text="尚未统计。" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    </StackPanel>
                    <DataGrid x:Name="MaterialGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Style="{StaticResource ModelGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项目" Binding="{Binding Item}" Width="Auto" MinWidth="86"/>
                            <DataGridTextColumn Header="规格" Binding="{Binding Specification}" Width="*" MinWidth="104"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding QuantityText}" Width="Auto" MinWidth="60"/>
                            <DataGridTextColumn Header="单重(kg)" Binding="{Binding UnitMassText}" Width="Auto" MinWidth="60"/>
                            <DataGridTextColumn Header="总重(kg)" Binding="{Binding TotalMassText}" Width="Auto" MinWidth="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
