<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.SpiralStairPage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/ModelingTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <proto:PrototypeChrome Title="罐体盘梯生成" Code="STAIR" Caption="HOME / 建模 / 罐体尺寸 · 梯梁踏步 · 栏杆" Icon="M2,20 V15 H7 V10 H12 V5 H17 V0 H22" Accent="#1F6FEB" IconBackground="#EAF2FF" IconBorder="#D3E2FF"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel x:Name="ParametersPanel">
                    <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="01 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="罐体与盘梯尺寸" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock Text="长度单位 mm；标高相对于点取的罐体中心基点。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                        <TextBlock Text="罐体外径" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="DiameterText" Text="20000" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="盘梯宽度" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="WidthText" Text="700" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                        <TextBlock Text="起点标高" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="StartText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="终点标高" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="EndText" Text="20000" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                        <TextBlock Text="休息平台高度间隔" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="IntervalText" Text="10000" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="罐壁间隙" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="GapText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                        <TextBlock Text="踏步高度" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="RiserText" Text="200" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="内缘踏面深度" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="DepthText" Text="250" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                        <TextBlock Text="休息平台内缘长度" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="LandingText" Text="1000" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="顶部平台内缘长度" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="TopText" Text="1000" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,8">
                                        <TextBlock Text="起始角（°）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                        <TextBox x:Name="AngleText" Text="0" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="盘梯旋转方向" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                <ComboBox x:Name="DirectionCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                <TextBlock Text="梯梁为 200×100×6 焊接U形板，背靠背布置；平台为与梁顶平齐的4mm平板，踏步前长边下折40mm、后长边上折40mm。" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="02 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="栏杆" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock Text="外侧栏杆随盘梯生成，包含顶部折回段。" TextWrapping="Wrap"/>
                                <CheckBox x:Name="InnerCheck" Content="生成内侧栏杆" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Margin="0,8,0,0" Style="{StaticResource ModelCheck}"/>
                                <TextBlock x:Name="InnerHint" Text="罐壁间隙大于100mm时强制生成内侧栏杆。" TextWrapping="Wrap" Margin="0,6,0,8"/>
                                <TextBlock Text="立柱最大间距（沿三维路径长度，300～2000mm）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                <TextBox x:Name="SpacingText" Text="2000" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                <TextBlock Text="立柱连接形式" Margin="0,8,0,5" FontWeight="SemiBold"/>
                                <ComboBox x:Name="ConnectionCombo" SelectionChanged="Parameter_Changed" Style="{StaticResource ModelCombo}"/>
                                <StackPanel x:Name="OffsetPanel" Margin="0,8,0,0">
                                    <TextBlock Text="立柱中心至连接板距离（类型2，须大于83mm）" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                    <TextBox x:Name="OffsetText" Text="120" TextChanged="Parameter_Changed" Style="{StaticResource ModelInput}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="03 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="布局检查" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock x:Name="LayoutText" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel>
                    <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                            <Run Text="04 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                            <Run Text="放置与确认" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                        </TextBlock>
                    </Border>
                    <StackPanel Margin="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                            </Grid.RowDefinitions>
                            <Button x:Name="PickButton" Content="点取罐体中心" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="32"/>
                            <Button x:Name="UpdateButton" Content="更新预览" Style="{StaticResource SecondaryButtonStyle}" Click="Update_Click" Margin="0" Grid.Column="2" Grid.Row="0" Height="32"/>
                            <Button x:Name="LogButton" Content="查看日志" Style="{StaticResource SecondaryButtonStyle}" Click="Log_Click" IsEnabled="False" Margin="0" Grid.Column="4" Grid.Row="0" Height="32"/>
                        </Grid>
                        <TextBlock Text="进度及用时显示在底部状态栏。辅助路径只在内存中使用。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="0" Grid.Column="0" Grid.Row="0" Height="36"/>
                            <Button x:Name="ConfirmButton" Content="确定生成" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click" IsEnabled="False" Grid.Column="2" Grid.Row="0" Margin="0" Height="36"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
