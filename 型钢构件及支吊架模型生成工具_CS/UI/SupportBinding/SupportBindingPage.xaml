<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SteelSectionProbe"
             x:Class="SteelSectionProbe.SupportBindingPage" x:ClassModifier="internal" Tag="prototype-v4" Background="#F4F7FA"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Prototype/SupportTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="95"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <local:PrototypeChrome Title="支吊架组合绑定" Code="组合" Caption="HOME / 支吊架 / 组合引注"
            Accent="#0E9F9A" IconBackground="#E6F6F5" IconBorder="#BDE6E2" Icon="M2,4 H9 V11 H2 Z M13,13 H20 V20 H13 Z M9,7 H16 V13 M5,11 V17 H13"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="ParameterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0"><TextBlock Text="01 /  选择管夹或耳轴" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/></Border>
                            <StackPanel Margin="12">
                                <TextBlock Text="选择已确认的原生管夹、立管耳轴或弯头耳轴，作为组合引注的定位点。" FontSize="11" TextWrapping="Wrap" Foreground="#5B6B7B" Margin="0,0,0,10"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button x:Name="PickTargetButton" Content="点取管夹 / 耳轴" Style="{StaticResource PrimaryButtonStyle}" Click="PickTarget_Click" Margin="0"/>
                                    <Button x:Name="StopButton" Grid.Column="2" Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="Stop_Click" Margin="0" IsEnabled="False"/>
                                </Grid>
                                <TextBox x:Name="TargetText" Text="尚未选择管夹或耳轴" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,10,0,0" Padding="0" MinHeight="24"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0"><TextBlock Text="02 /  关联承重支架" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/></Border>
                            <StackPanel Margin="12">
                                <Button x:Name="AddMemberButton" Content="点取承重支架，可连续添加" Style="{StaticResource SecondaryButtonStyle}" Click="AddMember_Click" IsEnabled="False" Margin="0,0,0,10"/>
                                <TextBlock Text="T型架、门型架、三角架等。从(2)开始编号，最多19项。同架最大管径计材，其余仅引用。" FontSize="11" TextWrapping="Wrap" Foreground="#5B6B7B" Margin="0,0,0,8"/>
                                <ListBox x:Name="MembersList" MinHeight="100" MaxHeight="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Member_Changed">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="2,4"/></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button x:Name="UpButton" Content="上移" Style="{StaticResource SecondaryButtonStyle}" Click="Up_Click" IsEnabled="False" Margin="0"/>
                                    <Button x:Name="DownButton" Grid.Column="2" Content="下移" Style="{StaticResource SecondaryButtonStyle}" Click="Down_Click" IsEnabled="False" Margin="0"/>
                                    <Button x:Name="RemoveButton" Grid.Column="4" Content="移除" Style="{StaticResource SecondaryButtonStyle}" Click="Remove_Click" IsEnabled="False" Margin="0"/>
                                </Grid>
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button x:Name="RefreshMembersButton" Content="核对 / 更新编号" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshMembers_Click" IsEnabled="False" Margin="0"/>
                                    <Button x:Name="ClearButton" Grid.Column="2" Content="解除全部关联" Style="{StaticResource SecondaryButtonStyle}" Click="Clear_Click" IsEnabled="False" Margin="0"/>
                                </Grid>
                                <TextBlock Text="移除和解除全部关联会立即保存，并删掉不再引用的材料符号。上移、下移和继续添加后，仍要点保存绑定。" FontSize="10.5" TextWrapping="Wrap" Foreground="#5B6B7B" Margin="0,10,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="OperationCard" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,6,6,0">
                <StackPanel>
                    <TextBlock Text="组合引注预览" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="PreviewText" Text="选择管夹后显示引注" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="100" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                    <TextBlock x:Name="EditStateText" Text="尚未选择管夹" FontSize="10.5" Foreground="#5B6B7B" TextWrapping="Wrap" Margin="0,8,0,8"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button x:Name="ReloadButton" Content="重新读取 / 放弃修改" Style="{StaticResource SecondaryButtonStyle}" Click="Reload_Click" IsEnabled="False" Margin="0" FontSize="11"/>
                        <Button x:Name="ConfirmButton" Grid.Column="2" Content="保存绑定" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" IsEnabled="False" Margin="0"/>
                    </Grid>
                    <Button x:Name="SyncMaterialsButton" Content="同步本模型组合材料" Style="{StaticResource SecondaryButtonStyle}" Click="SyncMaterials_Click" IsEnabled="False" Margin="0,8,0,0"/>
                    <TextBlock Text="保存后重新提取ISO。支持OPM撤销/重做。" FontSize="10.5" Foreground="#5B6B7B" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
