<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:proto="clr-namespace:SteelSectionProbe" x:Class="SteelSectionProbe.PipeAlignmentPage" x:ClassModifier="internal" Background="#F4F7FA" Tag="prototype-v4">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Prototype/ModelingTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <proto:PrototypeChrome Title="管道标高对齐" Code="ALIGN" Caption="HOME / 建模 / 基准 · 连通随动 · 锁 Z" Icon="M11,1 V18 M5,7 L11,1 L17,7 M2,21 H20" Accent="#1F6FEB" IconBackground="#EAF2FF" IconBorder="#D3E2FF"/>
        <Grid HorizontalAlignment="Stretch" Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Click="Reference_Click" Style="{StaticResource PrimaryButtonStyle}" Height="36" Padding="14,0" ToolTip="选择水平直管或直线作为基准；成功选择后清空原目标管。">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Stroke="White" StrokeThickness="1.3"/>
                                    <Path Data="M 8,0 L 8,4 M 8,12 L 8,16 M 0,8 L 4,8 M 12,8 L 16,8" Stroke="White" StrokeThickness="1.3"/>
                                </Grid>
                                <TextBlock Text="选择基准" VerticalAlignment="Center" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="01  基准 · 水平直管或直线" Style="{StaticResource SectionTitleStyle}"/>
                    </DockPanel>
                    <TextBlock x:Name="ReferenceText" FontFamily="Consolas" TextWrapping="Wrap" Text="尚未选择基准" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" MaxHeight="70" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="02 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="对齐方式与表面模式" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <TextBlock Text="对齐基准" Style="{StaticResource FieldLabelStyle}"/>
                                <UniformGrid Columns="3" Margin="0,5,0,10">
                                    <RadioButton x:Name="BottomRadio" GroupName="Align" Content="管底" Checked="Parameters_Changed" Style="{StaticResource ModelRadio}"/>
                                    <RadioButton x:Name="CenterRadio" GroupName="Align" Content="管中心" Checked="Parameters_Changed" Style="{StaticResource ModelRadio}"/>
                                    <RadioButton x:Name="TopRadio" GroupName="Align" Content="管顶" Checked="Parameters_Changed" Style="{StaticResource ModelRadio}"/>
                                </UniformGrid>
                                <TextBlock Text="表面模式 · 程序不会替你猜表面" Style="{StaticResource FieldLabelStyle}"/>
                                <UniformGrid Columns="2" Margin="0,5,0,10">
                                    <RadioButton x:Name="PipeSurface" GroupName="Surface" Content="管道外表面" Checked="Parameters_Changed" Style="{StaticResource ModelRadio}"/>
                                    <RadioButton x:Name="InsulationSurface" GroupName="Surface" Content="保温层外表面" Checked="Parameters_Changed" Style="{StaticResource ModelRadio}"/>
                                </UniformGrid>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="水平容差（mm）" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="ToleranceText" Text="1.000" FontFamily="Consolas" TextAlignment="Right" TextChanged="Parameters_Changed" Style="{StaticResource ModelInput}"/>
                                </DockPanel>
                                <Border Background="{DynamicResource CardSoftBrush}" Padding="10" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="移动范围" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                        <RadioButton x:Name="SingleScope" GroupName="Scope" Content="只移动选中的管道" Visibility="Collapsed" Checked="Parameters_Changed" Margin="0,4" Style="{StaticResource ModelRadio}"/>
                                        <RadioButton x:Name="GroupScope" GroupName="Scope" Content="连同连通对象一起移动" Checked="Parameters_Changed" Margin="0,4" Style="{StaticResource ModelRadio}"/>
                                        <RadioButton x:Name="ZScope" GroupName="Scope" Content="锁 Z 轴 · 立管 / 乙字弯伸缩，固定另一侧" Checked="Parameters_Changed" Margin="0,4" Style="{StaticResource ModelRadio}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Right" Background="#EAF2FA" BorderBrush="#C9DDEE" BorderThickness="1" CornerRadius="6" Padding="12,5">
                                    <TextBlock x:Name="CountText" Foreground="{DynamicResource StatusBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="03  目标管" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0"/>
                            </DockPanel>
                            <UniformGrid Columns="2">
                                <Button x:Name="PickTargetButton" Content="选择目标管" Click="Target_Click" ToolTip="右键：从模型选择集添加" Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,8,0" Background="#EAF2FA" BorderBrush="#B9D2E8" Foreground="{DynamicResource StatusBrush}" FontWeight="SemiBold">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M 1,5 L 1,1 L 5,1 M 11,1 L 15,1 L 15,5 M 15,11 L 15,15 L 11,15 M 5,15 L 1,15 L 1,11 M 4,8 L 12,8" Stroke="{DynamicResource StatusBrush}" StrokeThickness="1.4" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="从选择集添加" Click="Selection_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Content="清空目标管" Click="ClearTargets_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="04 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="预览 · 临时线，不改管道" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <WrapPanel>
                                    <CheckBox x:Name="ShowCurrent" Content="当前（蓝）" IsChecked="True" Checked="Preview_Changed" Unchecked="Preview_Changed" Margin="0,0,12,0" Style="{StaticResource ModelCheck}"/>
                                    <CheckBox x:Name="ShowTarget" Content="对齐后（红）" IsChecked="True" Checked="Preview_Changed" Unchecked="Preview_Changed" Style="{StaticResource ModelCheck}"/>
                                    <Button Content="刷新" Click="Preview_Click" Style="{StaticResource SecondaryButtonStyle}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="只读调试数据" Click="Debug_Click"/>
                                                <MenuItem Header="全部 EC 属性" Tag="all" Click="Debug_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button Content="清除" Click="ClearPreview_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center">
                                    <Run Text="05 /  " Foreground="#1F6FEB" FontFamily="Consolas" FontSize="10"/>
                                    <Run Text="管道明细 · × 移除起点管" Foreground="#1B2733" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"/>
                                </TextBlock>
                            </Border>
                            <StackPanel Margin="12">
                                <ListBox x:Name="PipeList" SelectionMode="Extended" MaxHeight="320" MinHeight="100" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,2" ToolTip="{Binding Details}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="×" Width="28" Height="28" Padding="0" Margin="8,0,0,0" Visibility="{Binding RemoveVisibility}" Click="RemoveRow_Click" ToolTip="移出目标列表，不删除模型管道" Style="{StaticResource SecondaryButtonStyle}"/>
                                                        <TextBlock Text="{Binding Name}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Connection}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,4"/>
                                                    <UniformGrid Columns="3">
                                                        <TextBlock Text="{Binding Current}" FontFamily="Consolas" TextAlignment="Right"/>
                                                        <TextBlock Text="{Binding Target}" FontFamily="Consolas" TextAlignment="Right"/>
                                                        <TextBlock Text="{Binding Delta}" FontFamily="Consolas" TextAlignment="Right"/>
                                                    </UniformGrid>
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,8,0,4"/>
                                <TextBlock x:Name="ReadoutText" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" MaxHeight="70" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="ApplyButton" Content="应用" Click="Apply_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Grid.Column="2" Content="重置" Click="Reset_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource StatusBrush}" Margin="0,6" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" MaxHeight="70" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
