<UserControl x:Class="SteelSectionProbe.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRowDef" Height="Auto" MinHeight="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- 顶部标题栏：功能页显示“标题 + 副标题 + 返回首页”；首页由 HomePage 自带标题栏
             （含搜索/排序），这里整块隐藏，避免出现两条标题。 -->
        <Grid x:Name="HeaderRow" Grid.Row="0" Margin="14,10,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="9" Height="9" Background="{StaticResource AccentBrush}"
                            CornerRadius="1" Margin="0,5,8,0" VerticalAlignment="Top" />
                    <TextBlock Text="型钢构件及支吊架模型生成工具"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="SubtitleText"
                           Text="选择功能模块开始建模"
                           FontSize="10.5"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="17,5,0,0" />
            </StackPanel>
            <Button x:Name="HomeButton" Grid.Column="1"
                    Content="返回首页"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Top"
                    Margin="8,0,0,0"
                    Click="HomeButton_Click" />
        </Grid>

        <ContentControl x:Name="PageHost" Grid.Row="1" Margin="14,4,10,10" />

        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,2,8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8"
                         Fill="{StaticResource AccentBrush}"
                         VerticalAlignment="Center" Margin="2,0,7,0" />
                <TextBlock x:Name="StatusText" Grid.Column="1"
                           Text="请选择一个功能模块。"
                           FontSize="10.5"
                           Foreground="{StaticResource StatusBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
                <Button Grid.Column="2" Content="关闭工具"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="28" MinWidth="78" Margin="8,0,0,0"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
