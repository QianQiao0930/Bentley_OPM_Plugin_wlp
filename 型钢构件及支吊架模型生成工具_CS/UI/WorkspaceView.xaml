<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SteelSectionProbe.WorkspaceView" x:ClassModifier="internal" Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="home">
                        <Setter Property="Margin" Value="1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="q-support-v4">
                        <Setter Property="Margin" Value="1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="prototype-v4">
                        <Setter Property="Margin" Value="1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRowDef" Height="Auto" MinHeight="88"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 顶部标题栏：功能页显示“标题 + 副标题 + 返回首页”；首页由 HomePage 自带标题栏
             （含搜索/排序），这里整块隐藏，避免出现两条标题。 -->
        <Grid x:Name="HeaderRow" Grid.Row="0" Margin="14,10,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="9" Height="9" Background="{StaticResource AccentBrush}" CornerRadius="1" Margin="0,5,8,0" VerticalAlignment="Top"/>
                    <TextBlock Text="型钢构件及支吊架模型生成工具" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock x:Name="SubtitleText" Text="选择功能模块开始建模" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="17,5,0,0"/>
            </StackPanel>
            <Button x:Name="HomeButton" Grid.Column="1" Content="返回首页" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" Margin="8,0,0,0" Click="HomeButton_Click"/>
        </Grid>
        <ContentControl x:Name="PageHost" Grid.Row="1">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Margin" Value="14,4,10,10"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Content.Tag, ElementName=PageHost}" Value="home">
                            <Setter Property="Margin" Value="0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Tag, ElementName=PageHost}" Value="q-support-v4">
                            <Setter Property="Margin" Value="0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Tag, ElementName=PageHost}" Value="prototype-v4">
                            <Setter Property="Margin" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
        <Border x:Name="WorkspaceFooter" Grid.Row="2" BorderThickness="0,1,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Content.Tag, ElementName=PageHost}" Value="home">
                            <Setter Property="Height" Value="46"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#DDE3EA"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Tag, ElementName=PageHost}" Value="q-support-v4">
                            <Setter Property="Height" Value="46"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#DDE3EA"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Tag, ElementName=PageHost}" Value="prototype-v4">
                            <Setter Property="Height" Value="46"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#DDE3EA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="10,2,8,2"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="home">
                                <Setter Property="Margin" Value="16,2,10,2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="q-support-v4">
                                <Setter Property="Margin" Value="16,2,10,2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="prototype-v4">
                                <Setter Property="Margin" Value="16,2,10,2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,7,0"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="请选择一个功能模块。" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="28" LineHeight="14" LineStackingStrategy="BlockLineHeight" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="10.5"/>
                            <Setter Property="Foreground" Value="{StaticResource StatusBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="home">
                                    <Setter Property="TextAlignment" Value="Left"/>
                                    <Setter Property="FontSize" Value="10.5"/>
                                    <Setter Property="Foreground" Value="#5B6B7B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="q-support-v4">
                                    <Setter Property="TextAlignment" Value="Left"/>
                                    <Setter Property="FontSize" Value="10.5"/>
                                    <Setter Property="Foreground" Value="#5B6B7B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="prototype-v4">
                                    <Setter Property="TextAlignment" Value="Left"/>
                                    <Setter Property="FontSize" Value="10.5"/>
                                    <Setter Property="Foreground" Value="#5B6B7B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="OPM ●" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#22A06B" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="home">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="q-support-v4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="prototype-v4">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="HomeEnterButton" Grid.Column="3" Content="进入" IsEnabled="False" Click="HomeEnter_Click" Height="30" MinWidth="0" Width="54" Padding="0" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Background" Value="#1F6FEB"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="home">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Background" Value="#1F6FEB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="4" MinWidth="0" Padding="0" Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                            <Setter Property="Width" Value="78"/>
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="Margin" Value="8,0,0,0"/>
                            <Setter Property="Content" Value="关闭工具"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="home">
                                    <Setter Property="Content" Value="关闭"/>
                                    <Setter Property="Width" Value="54"/>
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#DDE3EA"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="q-support-v4">
                                    <Setter Property="Content" Value="关闭工具"/>
                                    <Setter Property="Width" Value="78"/>
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#DDE3EA"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="prototype-v4">
                                    <Setter Property="Content" Value="关闭工具"/>
                                    <Setter Property="Width" Value="78"/>
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#DDE3EA"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Grid x:Name="BuildStatusPanel" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BuildPercentText" FontSize="10.5" Foreground="{StaticResource StatusBrush}"/>
                    <TextBlock x:Name="BuildStageText" Grid.Column="1" FontSize="10.5" Foreground="{StaticResource StatusBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="6,0"/>
                    <TextBlock x:Name="BuildElapsedText" Grid.Column="2" FontSize="10.5" Foreground="{StaticResource StatusBrush}" TextAlignment="Right"/>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="WorkspaceFrame" Visibility="Collapsed" Grid.RowSpan="3" Panel.ZIndex="100" Margin="-1" CornerRadius="8" BorderBrush="#C5CFDA" BorderThickness="1" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="home">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="q-support-v4">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Content.Tag,ElementName=PageHost}" Value="prototype-v4">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
