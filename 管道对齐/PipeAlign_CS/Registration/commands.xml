<?xml version="1.0" encoding="utf-8"?>
<!--
  PipeAlign 管道标高对齐 · Key-in 表（开发指南 §32）

  PIPEALIGN                    打开窗口（默认启动 UI）
  PIPEALIGN BOTTOM|CENTER|TOP  以指定模式打开窗口
  PIPEALIGN DEBUG              打印选中管道的调试数据，不修改模型
  PIPEALIGN DEBUG DUMP         在 DEBUG 之上追加全部 EC 属性
  PIPEALIGN OPTIONS            把当前运行参数写回配置文件，便于现场修改

  逻辑资源名固定为 CommandTable.xml（与 Bentley 加载约定一致，不要改）。
-->
<KeyinTree xmlns="http://www.bentley.com/schemas/1.0/MicroStation/AddIn/KeyinTree.xsd">
  <RootKeyinTable ID="root">
    <Keyword SubtableRef="PipeAlign" CommandClass="MacroCommand" CommandWord="PIPEALIGN">
      <Options Required="false" />
    </Keyword>
  </RootKeyinTable>

  <SubKeyinTables>
    <KeyinTable ID="PipeAlign">
      <Keyword CommandWord="BOTTOM" />
      <Keyword CommandWord="CENTER" />
      <Keyword CommandWord="TOP" />
      <Keyword SubtableRef="PipeAlignDebug" CommandWord="DEBUG">
        <Options Required="false" />
      </Keyword>
      <Keyword CommandWord="OPTIONS" />
      <Keyword CommandWord="ZMOVE" />
    </KeyinTable>
    <KeyinTable ID="PipeAlignDebug">
      <Keyword CommandWord="DUMP" />
    </KeyinTable>
  </SubKeyinTables>

  <KeyinHandlers>
    <KeyinHandler Keyin="PIPEALIGN" Function="PipeAlign.Keyins.OpenWindow" />
    <KeyinHandler Keyin="PIPEALIGN BOTTOM" Function="PipeAlign.Keyins.OpenWindowBottom" />
    <KeyinHandler Keyin="PIPEALIGN CENTER" Function="PipeAlign.Keyins.OpenWindowCenter" />
    <KeyinHandler Keyin="PIPEALIGN TOP" Function="PipeAlign.Keyins.OpenWindowTop" />
    <KeyinHandler Keyin="PIPEALIGN DEBUG" Function="PipeAlign.Keyins.DebugDump" />
    <KeyinHandler Keyin="PIPEALIGN DEBUG DUMP" Function="PipeAlign.Keyins.DebugDumpAll" />
    <KeyinHandler Keyin="PIPEALIGN OPTIONS" Function="PipeAlign.Keyins.WriteOptionsFile" />
    <KeyinHandler Keyin="PIPEALIGN ZMOVE" Function="PipeAlign.Keyins.OpenZMove" />
  </KeyinHandlers>
</KeyinTree>
