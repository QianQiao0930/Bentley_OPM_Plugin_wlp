  <ItemGroup><EmbeddedResource Include="commands.xml" LogicalName="CommandTable.xml" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="profiles.bin" LogicalName="SteelSectionProbe.profiles.bin" /></ItemGroup>
</Project>
