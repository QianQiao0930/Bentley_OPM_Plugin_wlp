<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SteelSectionProbe"
             x:Class="SteelSectionProbe.LineCoordinatesPage" x:ClassModifier="internal" Tag="prototype-v4" Background="#F4F7FA"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Prototype/PrototypeTheme.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="95"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <local:PrototypeChrome Title="直线坐标修改" Code="XYZ" Caption="HOME / 查询 / 直线端点坐标" Icon="M3,19 L19,3 M1,17 H5 V21 H1 Z M17,1 H21 V5 H17 Z"/>
        <Grid Grid.Row="1" Margin="16,12,10,12">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="ParameterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0"><TextBlock Text="01 /  点取直线" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/></Border>
                            <StackPanel Margin="12">
                                <TextBlock Text="点取一条直线段，读取起点和终点的 XYZ 坐标。" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button x:Name="PickButton" Content="点取直线" Style="{StaticResource PrimaryButtonStyle}" Click="Pick_Click" Margin="0"/>
                                    <Button x:Name="StopButton" Grid.Column="2" Content="结束点取" Style="{StaticResource SecondaryButtonStyle}" Click="Stop_Click" Margin="0" IsEnabled="False"/>
                                </Grid>
                                <TextBox x:Name="SelectionText" Text="尚未点取直线" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Margin="0,8,0,0" Padding="0" MinHeight="24"/>
                                <TextBlock Text="坐标单位：毫米（mm）· 模型 XYZ" FontSize="11" Foreground="#5B6B7B" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0"><TextBlock Text="02 /  起点坐标" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/></Border>
                            <Grid x:Name="StartFields" Margin="12" IsEnabled="False">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="X" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="StartXText" Grid.Column="1" TextChanged="Coordinate_Changed"/>
                                <TextBlock Text="Y" Grid.Row="1" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="StartYText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" TextChanged="Coordinate_Changed"/>
                                <TextBlock Text="Z" Grid.Row="2" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="StartZText" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" TextChanged="Coordinate_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <StackPanel>
                            <Border Height="35" BorderBrush="#E8EDF2" BorderThickness="0,0,0,1" Padding="12,0"><TextBlock Text="03 /  终点坐标" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/></Border>
                            <Grid x:Name="EndFields" Margin="12" IsEnabled="False">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="X" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="EndXText" Grid.Column="1" TextChanged="Coordinate_Changed"/>
                                <TextBlock Text="Y" Grid.Row="1" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="EndYText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" TextChanged="Coordinate_Changed"/>
                                <TextBlock Text="Z" Grid.Row="2" Style="{StaticResource FieldLabelStyle}"/><TextBox x:Name="EndZText" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" TextChanged="Coordinate_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="OperationCard" Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,6,6,0">
                <StackPanel>
                    <TextBlock x:Name="LengthText" Text="线段长度：—" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="EditStateText" Text="点取后可编辑；点击应用修改才会写入原线段。" FontSize="11" Foreground="#5B6B7B" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button x:Name="ReloadButton" Content="重新读取" Style="{StaticResource SecondaryButtonStyle}" Click="Reload_Click" IsEnabled="False" Margin="0"/>
                        <Button x:Name="ApplyButton" Grid.Column="2" Content="应用修改" Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click" IsEnabled="False" Margin="0"/>
                    </Grid>
                    <TextBlock Text="应用后可使用 OPM 撤销/重做。暂不支持折线。" TextWrapping="Wrap" FontSize="10.5" Foreground="#5B6B7B" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
